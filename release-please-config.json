{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "packages": {
    "gawk-server": {
      "release-type": "go",
      "component": "gawk-server",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "deploy/charts/gawk-server/Chart.yaml"
        }
      ]
    },
    "gawk-app": {
      "release-type": "node",
      "component": "gawk-app",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "deploy/charts/gawk-app/Chart.yaml"
        }
      ]
    },
    "gawk-broadcast": {
      "release-type": "go",
      "component": "gawk-broadcast",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "internal/version/version.go"
        }
      ]
    },
    "gawk-broadcast-windows": {
      "release-type": "simple",
      "component": "gawk-broadcast-windows",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "Cargo.toml"
        }
      ]
    },
    "gawk-telemetry": {
      "release-type": "go",
      "component": "gawk-telemetry",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "deploy/charts/gawk-telemetry/Chart.yaml"
        }
      ]
    }
  }
}
