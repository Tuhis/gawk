{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "packages": {
    "gawk-server": {
      "release-type": "go",
      "component": "gawk-server",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "deploy/charts/gawk-server/Chart.yaml"
        }
      ]
    },
    "gawk-app": {
      "release-type": "node",
      "component": "gawk-app",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "deploy/charts/gawk-app/Chart.yaml"
        }
      ]
    }
  }
}
