{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gawk.ioio.fi/schemas/events/fi.ioio.gawk.ban.removed.json",
  "title": "Ban removed",
  "description": "An operator lifted a ban before its expiry. The `data` of a `fi.ioio.gawk.ban.removed` CloudEvent.",
  "type": "object",
  "properties": {
    "actor": {
      "$ref": "common.json#/$defs/actor"
    },
    "broadcastKey": {
      "$ref": "common.json#/$defs/broadcastKey"
    },
    "broadcastId": {
      "$ref": "common.json#/$defs/broadcastId",
      "x-gawk-sensitive": true
    },
    "reason": {
      "$ref": "common.json#/$defs/reason"
    },
    "enforcement": {
      "$ref": "common.json#/$defs/enforcement"
    },
    "summary": {
      "$ref": "common.json#/$defs/summary"
    },
    "portalUrl": {
      "$ref": "common.json#/$defs/portalUrl"
    }
  },
  "required": [
