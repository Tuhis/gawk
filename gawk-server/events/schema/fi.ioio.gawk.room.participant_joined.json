{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gawk.ioio.fi/schemas/events/fi.ioio.gawk.room.participant_joined.json",
  "title": "Participant joined",
  "description": "A participant joined a room, or resumed within the rejoin window (`rejoin: true`). The `data` of a `fi.ioio.gawk.room.participant_joined` CloudEvent.",
  "type": "object",
  "properties": {
    "roomCode": {
      "$ref": "common.json#/$defs/roomCode",
      "x-gawk-sensitive": true
    },
    "roomKey": {
      "$ref": "common.json#/$defs/roomKey"
    },
    "displayCode": {
      "$ref": "common.json#/$defs/displayCode",
      "x-gawk-sensitive": true
    },
    "participantId": {
      "$ref": "common.json#/$defs/participantId"
    },
    "nickname": {
      "$ref": "common.json#/$defs/nickname"
    },
    "clientKind": {
      "$ref": "common.json#/$defs/clientKind"
    },
    "streaming": {
      "type": "boolean"
    },
    "speaking": {
      "type": "boolean"
    },
    "rejoin": {
      "type": "boolean"
    },
    "summary": {
      "$ref": "common.json#/$defs/summary"
    },
    "portalUrl": {
      "$ref": "common.json#/$defs/portalUrl"
    }
  },
  "required": [
    "roomKey",
    "participantId",
    "clientKind",
    "streaming",
    "speaking",
    "rejoin"
  ]
}
