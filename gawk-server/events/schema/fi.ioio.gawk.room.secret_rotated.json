{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gawk.ioio.fi/schemas/events/fi.ioio.gawk.room.secret_rotated.json",
  "title": "Room secret rotated",
  "description": "An operator rotated a static room's attach secret. The secret itself is never in any event. The `data` of a `fi.ioio.gawk.room.secret_rotated` CloudEvent.",
