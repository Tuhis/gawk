{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gawk.ioio.fi/schemas/events/fi.ioio.gawk.room.opened.json",
  "title": "Room opened",
  "description": "The home pod took a room live: a dynamic room's birth, or a static room's first attach. The `data` of a `fi.ioio.gawk.room.opened` CloudEvent.",
  "type": "object",
  "properties": {
    "roomCode": {
      "$ref": "common.json#/$defs/roomCode",
      "x-gawk-sensitive": true
    },
    "roomKey": {
      "$ref": "common.json#/$defs/roomKey"
    },
    "displayCode": {
      "$ref": "common.json#/$defs/displayCode",
      "x-gawk-sensitive": true
    },
    "kind": {
      "$ref": "common.json#/$defs/roomKind"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "summary": {
      "$ref": "common.json#/$defs/summary"
    },
    "portalUrl": {
      "$ref": "common.json#/$defs/portalUrl"
    }
  },
  "required": [
    "roomKey",
    "kind",
    "createdAt"
  ]
}
