{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gawk.ioio.fi/schemas/events/fi.ioio.gawk.broadcast.ended.json",
  "title": "Broadcast ended",
  "description": "The broadcast is gone from the fleet: garbage-collected after the grace period, killed by an operator, or replaced by a newer publisher session. The `data` of a `fi.ioio.gawk.broadcast.ended` CloudEvent.",
  "type": "object",
  "properties": {
    "broadcastId": {
      "$ref": "common.json#/$defs/broadcastId",
      "x-gawk-sensitive": true
    },
    "broadcastKey": {
      "$ref": "common.json#/$defs/broadcastKey"
    },
    "reason": {
      "type": "string",
      "enum": [
        "gc",
        "killed",
        "replaced"
      ]
    },
    "summary": {
      "$ref": "common.json#/$defs/summary"
    },
    "portalUrl": {
      "$ref": "common.json#/$defs/portalUrl"
    }
  },
  "required": [
    "broadcastKey",
    "reason"
  ]
}
