{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gawk.ioio.fi/schemas/events/fi.ioio.gawk.broadcast.killed.json",
  "title": "Broadcast killed",
  "description": "An operator ended a broadcast everywhere on the fleet (R39). The subject is the broadcast's key. The `data` of a `fi.ioio.gawk.broadcast.killed` CloudEvent.",
  "type": "object",
  "properties": {
    "actor": {
      "$ref": "common.json#/$defs/actor"
    },
    "broadcastKey": {
      "$ref": "common.json#/$defs/broadcastKey"
    },
    "broadcastId": {
      "$ref": "common.json#/$defs/broadcastId",
      "x-gawk-sensitive": true
    },
    "reason": {
      "$ref": "common.json#/$defs/reason"
    },
    "enforcement": {
      "$ref": "common.json#/$defs/enforcement"
    },
    "summary": {
      "$ref": "common.json#/$defs/summary"
    },
    "portalUrl": {
      "$ref": "common.json#/$defs/portalUrl"
    }
  },
  "required": [
    "actor"
  ]
}
