{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gawk.ioio.fi/schemas/events/fi.ioio.gawk.room.ended.json",
  "title": "Room ended",
  "description": "A room ended: an operator ended or deleted it (actor is their identity), or the relay ended it on its own (actor `system`, reason says why). The `data` of a `fi.ioio.gawk.room.ended` CloudEvent.",
  "type": "object",
  "properties": {
    "actor": {
      "$ref": "common.json#/$defs/actor"
    },
    "roomKey": {
      "$ref": "common.json#/$defs/roomKey"
    },
    "roomCode": {
      "$ref": "common.json#/$defs/roomCode",
      "x-gawk-sensitive": true
    },
    "displayCode": {
      "$ref": "common.json#/$defs/displayCode",
      "x-gawk-sensitive": true
    },
    "kind": {
      "$ref": "common.json#/$defs/roomKind"
    },
    "reason": {
      "$ref": "common.json#/$defs/reason"
    },
    "summary": {
      "$ref": "common.json#/$defs/summary"
    },
    "portalUrl": {
      "$ref": "common.json#/$defs/portalUrl"
    }
  },
  "required": [
    "actor"
  ]
}
