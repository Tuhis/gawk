node_modules/
e2e/bin/
# Every e2e run directory. The harness takes its output dir from
# GAWK_E2E_OUT_DIR, and CI already uses four different values (out,
# out-muxer-check, out-telemetry, out-browser-broadcast) — listing them one by
# one left two of them untracked-but-not-ignored, so running those steps
# locally the way CI does leaves debris behind. A glob covers the ones that
# exist and the next one somebody adds.
e2e/out*/
.claude/worktrees

.DS_Store

# R38 (docs/41 §5): the local dev stack's working files. A private key in a
# public repository is not a mistake with a warning attached — CAs must revoke
# keys reported as compromised within 24 hours — so the certificate directory
# is ignored wholesale and only its placeholder is tracked. .env holds DNS
# provider tokens in the ACME lane.
certs/*
!certs/.gitkeep
dev/generated/*
!dev/generated/.gitkeep
.env

# Byte-compiled helpers under tools/ (gen-notices.py is imported by its own
# negative test, which leaves one behind).
__pycache__/
*.pyc

# R41 (docs/43): coverage reports. Produced by every `npm run test:coverage`,
# `go test -coverprofile` and `cargo llvm-cov` run, published to the `badges`
# branch by CI, and never committed to this one — the number a badge shows must
# come from a CI run, not from whatever somebody's laptop last measured.
#
# The vitest output directories are listed one by one rather than as a bare
# `coverage/`, which would also match `tools/coverage/` and
# `.github/actions/coverage/` — the tooling itself — and silently leave them
# out of the commit that adds them.
/gawk-app/coverage/
/gawk-admin/ui/coverage/
/gawk-telemetry/ui/coverage/
coverage.out
coverage-llvm.json
