{
  // JSON5, not JSON, *because* of the comments below: Renovate rejects `"//"`
  // keys inside nested option objects as invalid configuration and stops
  // opening PRs on this repo entirely until they are gone (issue #226).
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  postUpdateOptions: ["gomodTidy"],

  // Regenerate the third-party attribution files in the same PR as the bump
  // that invalidated them. Renovate is how dependencies change here, so
  // without this the notices drift on every bump and the `licenses-fresh` CI
  // job turns every Renovate PR red for a reason the bot could have fixed
  // itself.
  //
  // REQUIRES BOT-SIDE CONFIG: postUpgradeTasks is ignored unless the
  // self-hosted bot's global config allowlists the command via allowedCommands
  // / RENOVATE_ALLOWED_COMMANDS (allowedPostUpgradeCommands on older
  // releases). Without it this block is inert — nothing breaks, the notices
  // simply stay stale and CI says so. See CONTRIBUTING.md.
  postUpgradeTasks: {
    commands: ["python3 tools/licenses/gen-notices.py"],
    fileFilters: ["**/THIRD-PARTY-NOTICES.md"],
    executionMode: "branch",
  },

  packageRules: [
    {
      description: "Bump the Kubernetes libraries together — api/apimachinery/client-go must move in lockstep, and splitting them (as PRs #62/#63/#65 were) invites incompatible partial upgrades.",
      matchManagers: ["gomod"],
      matchPackageNames: ["k8s.io/**", "sigs.k8s.io/**"],
      groupName: "kubernetes packages",
    },
    {
      description: "quic-go and webtransport-go are direct deps of BOTH Go modules; grouping makes a bump edit (and gomodTidy) both go.mod files in one PR so they never drift apart.",
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/quic-go/**"],
      groupName: "quic-go",
    },
    {
      description: "The Prometheus client libraries (client_golang + client_model) share a release cadence and transitive graph — land them together.",
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/prometheus/**"],
      groupName: "prometheus packages",
    },
    {
      description: "gawk-server is always locally replaced (`replace github.com/Tuhis/gawk/gawk-server => ../gawk-server`) in gawk-broadcast and gawk-telemetry, so the require line's version is a placeholder that Go never actually fetches. Renovate's digest updater doesn't know that and rewrites it to a bare commit hash missing the required v0.0.0-<timestamp>- pseudo-version prefix, which fails go.mod parsing in CI (PR #155).",
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/Tuhis/gawk/gawk-server"],
      enabled: false,
    },
  ],
}
