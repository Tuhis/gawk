{
  // JSON5, not JSON, *because* of the comments below: Renovate rejects `"//"`
  // keys inside nested option objects as invalid configuration and stops
  // opening PRs on this repo entirely until they are gone (issue #226).
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  postUpdateOptions: ["gomodTidy"],

  // An issue listing every pending, rate-limited and failing update. Without
  // it a stuck run is invisible: in 2026-10 the bot aborted every gawk run a
  // few branches in, ~70 updates queued up behind it, and the only symptom was
  // Dependabot alerts with no matching PRs.
  dependencyDashboard: true,

  // The bot runs once a day, so the default prHourlyLimit of 2 is really two
  // new PRs a day, and a backlog takes weeks to drain. prConcurrentLimit
  // (default 10 open at once) stays the cap on review load.
  prHourlyLimit: 0,

  // Regenerate the third-party attribution files in the same PR as the bump
  // that invalidated them. Renovate is how dependencies change here, so
  // without this the notices drift on every bump and the `licenses-fresh` CI
  // job turns every Renovate PR red for a reason the bot could have fixed
  // itself.
  //
  // Before that, tidy the Go modules that build gawk-server through a local
  // replace. A bump that moves gawk-server/go.mod changes their graph too, and
  // gomodTidy only tidies the go.mod files Renovate edited, so they were left
  // stale: CI's tidy job and every build in them went red, and gen-notices.py
  // died on the same "updates to go.mod needed" (PRs #608, #611, #614 each
  // needed a hand-made tidy commit). It must run first, since gen-notices.py
  // lists those modules.
  //
  // REQUIRES BOT-SIDE CONFIG: postUpgradeTasks is ignored unless the
  // self-hosted bot's global config allowlists each command via
  // allowedCommands / RENOVATE_ALLOWED_COMMANDS (allowedPostUpgradeCommands on
  // older releases). A command missing from it is skipped with an artifact
  // warning on the PR; the rest still run. See CONTRIBUTING.md.
  postUpgradeTasks: {
    commands: [
      "tools/renovate/tidy-go.sh",
      "python3 tools/licenses/gen-notices.py",
    ],
    // -*: the desktop's -macos and -linux files too, which the apps embed
    // (docs/74), so a stale one ships inside the binary.
    fileFilters: [
      "**/THIRD-PARTY-NOTICES*.md",
      "*/go.mod",
      "*/go.sum",
    ],
    executionMode: "branch",
  },

  // Refresh every lockfile weekly. Without this Renovate only bumps direct
  // dependencies, so a security fix that lands in a transitive one (undici
  // under jsdom, 2026-09) never gets a PR even when the existing ranges
  // already allow it, and the Dependabot alerts just accumulate.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on monday"],
  },

  packageRules: [
    {
      description: "Bump the Kubernetes libraries together — api/apimachinery/client-go must move in lockstep, and splitting them (as PRs #62/#63/#65 were) invites incompatible partial upgrades.",
      matchManagers: ["gomod"],
      matchPackageNames: ["k8s.io/**", "sigs.k8s.io/**"],
      groupName: "kubernetes packages",
    },
    {
      description: "quic-go and webtransport-go are direct deps of BOTH Go modules; grouping makes a bump edit (and gomodTidy) both go.mod files in one PR so they never drift apart.",
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/quic-go/**"],
      groupName: "quic-go",
    },
    {
      description: "gawk-server builds quic-go from a vendored, patched copy (gawk-server/third_party/quic-go, docs/75 D7) through a local `replace`, so a bump of the require line alone changes nothing that is built and leaves the line lying about what is. Bump it by hand as that directory's GAWK-PATCH.md says. A webtransport-go bump that drags quic-go forward fails CI's re-derive check until the copy follows. Drop this rule with the copy.",
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/quic-go/quic-go"],
      enabled: false,
    },
    {
      description: "The vendored quic-go's own go.mod is upstream's, regenerated by gawk-derive.sh beside it and checked by CI; an edit from Renovate would only be reverted.",
      matchFileNames: ["gawk-server/third_party/**"],
      enabled: false,
    },
    {
      description: "The Prometheus client libraries (client_golang + client_model) share a release cadence and transitive graph — land them together.",
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/prometheus/**"],
      groupName: "prometheus packages",
    },
    {
      description: "gawk-server is always locally replaced (`replace github.com/Tuhis/gawk/gawk-server => ../gawk-server`) in gawk-telemetry and gawk-admin, so the require line's version is a placeholder that Go never actually fetches. Renovate's digest updater doesn't know that and rewrites it to a bare commit hash missing the required v0.0.0-<timestamp>- pseudo-version prefix, which fails go.mod parsing in CI (PR #155).",
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/Tuhis/gawk/gawk-server"],
      enabled: false,
    },
    {
      description: "The uplink lab's Rust sender (docs/75) is its own Cargo workspace but keeps no versions of its own: tools/uplinklab/build.sh builds it from a copy of the desktop workspace's Cargo.lock, and CI never builds it, so a bump here would only drift it off the stack it measures.",
      matchFileNames: ["gawk-broadcast-desktop/tools/uplinklab/**"],
      enabled: false,
    },
    {
      description: "gawk-broadcast-desktop/vendor holds patched copies of quinn-proto, wtransport and wtransport-proto (each one's GAWK-PATCH.md), excluded from the workspace. Their Cargo.toml files are upstream's published manifests, so an edit there is never right, and Renovate runs `cargo update --manifest-path vendor/<crate>/Cargo.toml` outside the workspace, which fails or commits nothing. Their dependencies resolve through the workspaces' Cargo.lock and move with lock file maintenance; a new upstream version of a copy is re-derived by hand.",
      matchFileNames: ["gawk-broadcast-desktop/vendor/**"],
      enabled: false,
    },
  ],
}
