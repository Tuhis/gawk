// The gawk-broadcast window, shared by the Windows, macOS and Linux shells
// (docs/54 D11): the platforms differ in properties and one card — the
// Windows picker page or the system picker's Share card, chosen by
// `system-picker` — never in a forked file.
//
// R58 (docs/60): pages instead of a card stack (D1), in the web app's
// visual language (D2, the tokens of gawk-app/src/styles/global.css), with
// one primary action per page (D3). Still one window, and the window is the
// app (docs/38 D12).
//
// R62 (docs/64): the header states the server's status instead of a pill
// that navigated (D1–D3); one element vocabulary (D4); the same rows on
// every page (D5); Live is one layout alone or in a room (D6); Pause keeps
// the code and Paused is the Live view with its buttons and badge swapped
// (D9); End leaves a summary card on Ready (D10); the code and the link copy
// on click (D17); Quality and Settings are two pages (D18).
//
// R64 (docs/66): on Ready, Live and Paused only the body scrolls. The
// page's buttons sit in a pinned action bar (D2), problems viewers feel now
// in an alert slot under the header (D4), and one elastic element per page
// gives up height first (D5). The page publishes what it needs for the
// shell's window fit (D8).

import { ScrollView } from "std-widgets.slint";

export struct WindowRow {
    hwnd: int,
    pid: int,
    title: string,
    icon: image,
    has-icon: bool,
}

export struct MonitorRow {
    hmonitor: int,
    label: string,
}

// One application emitting audio, for the whose-audio step (Linux, docs/58 D9).
export struct AudioAppRow {
    name: string,
    binary: string,
    streams: int,
}

export struct StatRow {
    label: string,
    value: string,
}

// One line of the in-app roster (docs/60 D9): a stream in the room.
export struct RoomRow {
    name: string,
    detail: string,
    initial: string,
    tint: int,
    you: bool,
    away: bool,
    speaking: bool,
    broadcast-id: string,
    watch-link: string,
    removable: bool,
}

// One line of "Your rooms" (docs/60 D8).
export struct RecentRow {
    code: string,
    detail: string,
    saved: bool,
}

// Everything the Live page's right-hand side shows: one value, so the
// narrow and wide layouts (two instances of LiveSide) cannot drift apart.
struct LiveView {
    live: bool,
    paused: bool,
    starting: bool,
    resuming: bool,
    code: string,
    code-chars: [string],
    join-link: string,
    mono-font: string,
    sharing-title: string,
    sharing-detail: string,
    sharing-window: bool,
    sharing-can-change: bool,
    audio-line: string,
    audio-level: float,
    quality-title: string,
    quality-detail: string,
    upload-title: string,
    upload-detail: string,
    // 0 steady (green), 1 struggling or reconnecting (amber), 2 idle (grey)
    upload-state: int,
    room-active: bool,
    room-code: string,
    room-link: string,
    room-status: string,
    room-creator: bool,
    room-streaming: int,
    room-watching: int,
    room-rows: [RoomRow],
    room-watchers: string,
    room-watcher-initials: [string],
    room-needs-key: bool,
    room-pending: string,
    room-pending-detail: string,
    room-left: string,
}

// gawk-app/src/styles/global.css, verbatim where a value exists there.
global T {
    out property <color> bg: #0a0b0d;
    out property <color> chrome: #08090b;
    out property <color> s1: #121317;
    out property <color> s2: #171920;
    out property <color> s3: #1d2029;
    out property <color> border: #262a33;
    out property <color> border-soft: #1c2028;
    out property <color> text: #e8eaed;
    out property <color> muted: #9aa1ad;
    out property <color> faint: #626873;
    out property <color> accent: #6b8afe;
    out property <color> accent-text: #aebeff;
    out property <color> accent-soft: #6b8afe24;
    out property <color> accent-line: #6b8afe59;
    out property <color> accent-hover: #6b8afe14;
    out property <color> live: #e5484d;
    out property <color> live-soft: #e5484d24;
    out property <color> live-text: #ff8589;
    out property <color> danger-text: #f0686c;
    out property <color> danger-line: #e5484d80;
    out property <color> ok: #30a46c;
    out property <color> ok-text: #8fdcb2;
    out property <color> warn: #d0a215;
    out property <color> warn-soft: #d0a21517;
    out property <color> warn-line: #d0a21552;
    out property <color> warn-text: #e6c14d;
    out property <color> scrim: #050506a8;
    out property <color> glass: #000000a0;
    out property <color> tip: #262a33;
    out property <color> tip-line: #353a46;

    // Avatar fills (the roster's initials), picked by index.
    public pure function tint(i: int) -> color {
        if (Math.mod(i, 6) == 0) {
            return #aebeff;
        }
        if (Math.mod(i, 6) == 1) {
            return #f2b57a;
        }
        if (Math.mod(i, 6) == 2) {
            return #8fd1b5;
        }
        if (Math.mod(i, 6) == 3) {
            return #c7a8f5;
        }
        if (Math.mod(i, 6) == 4) {
            return #f5a8c0;
        }
        return #9ad0f5;
    }
}

// Stroke icons on a 24-unit grid.
global Icons {
    out property <string> settings: "M4 7h9M17 7h3M4 12h3M11 12h9M4 17h11M19 17h1M13 7a2 2 0 1 0 4 0a2 2 0 1 0 -4 0M7 12a2 2 0 1 0 4 0a2 2 0 1 0 -4 0M15 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0";
    out property <string> chevron-right: "M10 7l5 5-5 5";
    out property <string> back: "M15 6l-6 6 6 6";
    out property <string> close: "M6 6l12 12M18 6L6 18";
    out property <string> plus: "M12 5v14M5 12h14";
    out property <string> check: "M5 12.5l4.5 4.5L19 7";
    out property <string> stop: "M8 6h8a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2H8a2 2 0 0 1 -2 -2V8a2 2 0 0 1 2 -2z";
    out property <string> pause: "M9 6v12M15 6v12";
    out property <string> play: "M8 5.5v13l10.5 -6.5z";
    out property <string> link: "M10 14a4 4 0 0 0 5.7 0l3 -3a4 4 0 0 0 -5.7 -5.7l-1 1M14 10a4 4 0 0 0 -5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1 -1";
    out property <string> copy: "M10 8h8a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-8a2 2 0 0 1 -2 -2v-8a2 2 0 0 1 2 -2zM16 8V6a2 2 0 0 0 -2 -2H6a2 2 0 0 0 -2 2v8a2 2 0 0 0 2 2h2";
    out property <string> external: "M14 4h6v6M20 4l-9 9M18 14v4a2 2 0 0 1 -2 2H6a2 2 0 0 1 -2 -2V8a2 2 0 0 1 2 -2h4";
    out property <string> activity: "M3 12h4l3 -8 4 16 3 -8h4";
    out property <string> refresh: "M20 11a8 8 0 0 0 -14.9 -3M4 5v4h4M4 13a8 8 0 0 0 14.9 3M20 19v-4h-4";
    out property <string> star: "M12 3.5L14.6 8.8L20.5 9.7L16.2 13.8L17.2 19.6L12 16.9L6.8 19.6L7.8 13.8L3.5 9.7L9.4 8.8Z";
    out property <string> alert: "M12 4L21 20H3ZM12 10v4M12 17.5v0.5";
    out property <string> speaker: "M4 9v6h4l5 4V5L8 9H4zM16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12";
    out property <string> users: "M5.5 8a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0 -7 0M2.5 20a6.5 6.5 0 0 1 13 0M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14a6.5 6.5 0 0 1 3.5 6";
    out property <string> eye: "M2 12C4 8 7.5 5 12 5C16.5 5 20 8 22 12C20 16 16.5 19 12 19C7.5 19 4 16 2 12ZM9 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0";
    out property <string> gauge: "M4 16a8 8 0 1 1 16 0M12 16l4 -5";
    out property <string> monitor: "M5 4h14a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2H5a2 2 0 0 1 -2 -2V6a2 2 0 0 1 2 -2zM8 20h8M12 16v4";
    out property <string> window: "M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2H5a2 2 0 0 1 -2 -2V6a2 2 0 0 1 2 -2zM3 9h18";
    out property <string> leave: "M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-4M10 16l-4 -4 4 -4M6 12h10";
    out property <string> key: "M4 15a4 4 0 1 0 8 0a4 4 0 1 0 -8 0M11 12l9 -9M17 6l3 3";
    out property <string> signal: "M12 20V10M7 20v-5M17 20V5";
    out property <string> server: "M5 4h14a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1H5a1 1 0 0 1 -1 -1V5a1 1 0 0 1 1 -1zM5 14h14a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1H5a1 1 0 0 1 -1 -1v-4a1 1 0 0 1 1 -1zM8 7h.01M8 17h.01";
    out property <string> swap: "M7 7h11l-3 -3M17 17H6l3 3";
    out property <string> download: "M12 4v11M7 10l5 5 5 -5M5 20h14";
}

component Icon inherits Path {
    in property <color> ink: T.muted;
    in property <length> size: 18px;
    in property <bool> filled;
    width: self.size;
    height: self.size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: self.ink;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: self.filled ? self.ink : transparent;
    accessible-role: none;
}

// A small tooltip above its parent: "Click to copy", then "Copied".
component Tip inherits Rectangle {
    in property <string> text;
    in property <bool> done;
    height: 26px;
    width: tl.preferred-width;
    border-radius: 7px;
    border-width: 1px;
    border-color: T.tip-line;
    background: T.tip;
    tl := HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 5px;
        cross-axis-alignment: center;
        if root.done: Icon {
            commands: Icons.check;
            ink: T.ok-text;
            size: 13px;
        }
        Text {
            text: root.text;
            color: root.done ? T.ok-text : T.text;
            font-size: 12px;
            font-weight: 500;
        }
    }
}

// The web app's <Button> (docs/10): primary is the near-white fill, never a
// coloured one; danger is an outline. docs/64 D4: primary is the page's next
// step (one per page), secondary acts now, ghost is low stakes, danger ends
// something others depend on, accent is the room's own link.
component Btn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    // 0 primary, 1 secondary, 2 ghost, 3 danger, 4 accent
    in property <int> kind: 1;
    in property <bool> enabled: true;
    in property <bool> large;
    in property <bool> small;
    in property <bool> icon-filled;
    // docs/66 D2: a copy button confirms in place — for 1.2 s a green check
    // and "Copied", with the button's width held.
    in property <bool> confirm;
    // Only the icon shows; the text stays its accessible name (CopyIconBtn
    // adds the tip).
    in property <bool> icon-only;
    out property <bool> hovered: ta.has-hover;
    out property <bool> flash;
    // The width with its label shown, in this font, whatever `icon-only`
    // says: the action bar sizes itself from it (docs/66 D2).
    out property <length> labelled-width: (root.small ? 24px : 32px)
        + (root.icon != "" ? (root.small ? 15px : 17px) + 8px : 0px) + measure.preferred-width;
    callback clicked;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    property <color> fg: self.kind == 0 ? #0a0b0d
        : self.kind == 2 ? (ta.has-hover ? T.text : T.muted)
        : self.kind == 3 ? T.danger-text
        : self.kind == 4 ? T.accent-text
        : T.text;
    height: self.large ? 52px : self.small ? 32px : 40px;
    border-radius: self.large ? 12px : self.small ? 8px : 10px;
    border-width: 1px;
    opacity: self.enabled ? 1 : 0.45;
    background: self.kind == 0 ? (ta.has-hover && self.enabled ? #ffffff : T.text)
        : self.kind == 1 ? (ta.has-hover && self.enabled ? T.s1 : T.s2)
        : self.kind == 2 ? (ta.has-hover && self.enabled ? #ffffff0d : transparent)
        : self.kind == 3 ? (ta.has-hover && self.enabled ? T.live-soft : transparent)
        : T.accent-soft;
    border-color: self.kind == 1 ? (ta.has-hover && self.enabled ? T.faint : T.border)
        : self.kind == 3 ? (ta.has-hover && self.enabled ? T.live : T.danger-line)
        : self.kind == 4 ? T.accent-line
        : transparent;
    accessible-role: button;
    accessible-label: self.text;
    accessible-enabled: self.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.press();
        }
    }
    function press() {
        if (root.confirm) {
            root.flash = true;
        }
        root.clicked();
    }
    Timer {
        interval: 1200ms;
        running: root.flash;
        triggered => {
            root.flash = false;
        }
    }
    // The label's width at rest, so "Copied" doesn't shrink the button.
    measure := Text {
        visible: false;
        accessible-role: none;
        text: root.text;
        font-size: root.large ? 16px : root.small ? 13px : 14px;
        font-weight: root.kind == 0 ? 600 : 500;
    }
    HorizontalLayout {
        padding-left: root.icon-only ? 0px : root.small ? 12px : 16px;
        padding-right: root.icon-only ? 0px : root.small ? 12px : 16px;
        spacing: 8px;
        alignment: center;
        cross-axis-alignment: center;
        if root.icon != "": Icon {
            commands: root.flash ? Icons.check : root.icon;
            ink: root.flash ? T.ok : root.fg;
            filled: root.icon-filled && !root.flash;
            size: root.small ? 15px : 17px;
        }
        if !root.icon-only: Text {
            text: root.flash ? "Copied" : root.text;
            min-width: root.confirm ? measure.preferred-width : 0px;
            color: root.fg;
            font-size: root.large ? 16px : root.small ? 13px : 14px;
            font-weight: root.kind == 0 ? 600 : 500;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.press();
        }
    }
}

// The action bar's Copy code (docs/66 D2): labelled, or an icon when the
// window is too narrow for the labelled bar (MainWindow's `narrow-bar`).
// As an icon its name stays the accessible label and becomes the hover tip.
// The explicit size keeps the tip from widening the button.
component CopyCodeBtn inherits Rectangle {
    in property <bool> narrow;
    in property <bool> enabled: true;
    callback clicked;
    out property <length> labelled-width: b.labelled-width;
    width: root.narrow ? 40px : b.labelled-width;
    height: 40px;
    b := Btn {
        width: 100%;
        height: 100%;
        icon: Icons.copy;
        text: "Copy code";
        icon-only: root.narrow;
        confirm: true;
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    if root.narrow && (b.hovered || b.flash): Tip {
        text: b.flash ? "Copied" : "Copy code";
        done: b.flash;
        x: (parent.width - self.width) / 2;
        y: -self.height - 6px;
    }
}

component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <color> ink: T.muted;
    in property <length> box: 40px;
    in property <bool> filled;
    callback clicked;
    width: self.box;
    height: self.box;
    border-radius: 10px;
    background: ta.has-hover ? #ffffff0d : transparent;
    accessible-role: button;
    accessible-label: self.label;
    accessible-action-default => {
        root.clicked();
    }
    Icon {
        commands: root.icon;
        ink: ta.has-hover ? T.text : root.ink;
        filled: root.filled;
        size: root.box >= 40px ? 18px : 15px;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// The row's one navigation affordance, "Change ›" (docs/64 D4): the only
// control with a chevron, and it always opens a page or a sheet.
component RowLink inherits Rectangle {
    in property <string> text;
    in property <bool> chevron: true;
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    height: 32px;
    border-radius: 8px;
    opacity: self.enabled ? 1 : 0.45;
    background: ta.has-hover && self.enabled ? #ffffff0d : transparent;
    accessible-role: button;
    accessible-label: self.text;
    accessible-enabled: self.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 4px;
        cross-axis-alignment: center;
        if root.icon != "": Icon {
            commands: root.icon;
            ink: ta.has-hover ? T.text : T.muted;
            size: 13px;
        }
        Text {
            text: root.text;
            color: ta.has-hover && root.enabled ? T.text : T.muted;
            font-size: 13px;
        }
        if root.chevron: Icon {
            commands: Icons.chevron-right;
            ink: ta.has-hover && root.enabled ? T.text : T.muted;
            size: 15px;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// docs/64 D4: a pill states a fact. Never clickable, never a ⌄.
// 0 neutral, 1 accent
component Pill inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <int> kind;
    in property <bool> mono;
    in property <string> mono-font;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    height: 28px;
    border-radius: 14px;
    border-width: 1px;
    background: self.kind == 1 ? T.accent-soft : T.s1;
    border-color: self.kind == 1 ? T.accent-line : T.border;
    accessible-role: AccessibleRole.text;
    accessible-label: self.text;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        cross-axis-alignment: center;
        if root.icon != "": Icon {
            commands: root.icon;
            size: 14px;
            ink: root.kind == 1 ? T.accent-text : T.muted;
        }
        Text {
            text: root.text;
            font-size: 12.5px;
            font-family: root.mono ? root.mono-font : "";
            color: root.kind == 1 ? T.accent-text : T.muted;
        }
    }
}

// What the broadcast is doing (docs/64 D4): LIVE, PAUSED, RECONNECTING,
// STARTING. 0 live, 1 paused, 2 reconnecting, 3 starting
component Badge inherits Rectangle {
    in property <int> kind;
    in property <string> elapsed;
    height: 28px;
    horizontal-stretch: 0;
    border-radius: 6px;
    border-width: self.kind == 1 ? 1px : 0px;
    border-color: T.border;
    background: self.kind == 0 ? T.live-soft : self.kind == 2 ? T.warn-soft : T.s2;
    accessible-role: text;
    accessible-label: (self.kind == 0 ? "Live " : self.kind == 1 ? "Paused " : self.kind == 2 ? "Reconnecting" : "Starting") + self.elapsed;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;
        cross-axis-alignment: center;
        if root.kind != 1: Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.kind == 0 ? T.live : root.kind == 2 ? T.warn : T.faint;
        }
        if root.kind == 1: Icon {
            commands: Icons.pause;
            ink: T.muted;
            size: 13px;
        }
        Text {
            text: root.kind == 0 ? "LIVE" : root.kind == 1 ? "PAUSED" : root.kind == 2 ? "RECONNECTING" : "STARTING";
            color: root.kind == 0 ? T.live-text : root.kind == 2 ? T.warn-text : T.muted;
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 1.2px;
        }
        if (root.kind == 0 || root.kind == 1) && root.elapsed != "": Text {
            text: root.elapsed;
            color: T.text;
            font-size: 11.5px;
            font-weight: 500;
        }
    }
}

component Kicker inherits Text {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 1.5px;
    color: T.muted;
}

// A rounded list; its rows draw their own dividers.
component List inherits Rectangle {
    vertical-stretch: 0;
    background: T.s1;
    border-width: 1px;
    border-color: T.border;
    border-radius: 16px;
    clip: true;
    VerticalLayout {
        @children
    }
}

component RowIco inherits Rectangle {
    in property <string> icon;
    in property <bool> accent;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: self.accent ? #6b8afe2e : T.s3;
    Icon {
        commands: root.icon;
        ink: root.accent ? T.accent-text : T.muted;
    }
}

component Row inherits Rectangle {
    in property <bool> first;
    in property <bool> tinted;
    // A whole-row click target; controls inside the row sit above it.
    in property <bool> clickable;
    in property <bool> enabled: true;
    callback clicked;
    min-height: 52px;
    background: self.tinted ? #6b8afe12 : (self.clickable && self.enabled && rta.has-hover ? #ffffff08 : transparent);
    opacity: self.enabled ? 1 : 0.5;
    if !root.first: Rectangle {
        y: 0;
        height: 1px;
        background: T.border-soft;
    }
    rta := TouchArea {
        enabled: root.clickable && root.enabled;
        mouse-cursor: root.clickable && root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        cross-axis-alignment: center;
        @children
    }
}

component RowText inherits VerticalLayout {
    in property <string> title;
    in property <string> sub;
    in property <color> sub-color: T.muted;
    in property <string> title-font;
    horizontal-stretch: 1;
    spacing: 1px;
    alignment: center;
    Text {
        text: root.title;
        color: T.text;
        font-size: 14px;
        font-weight: 500;
        font-family: root.title-font;
        overflow: elide;
    }
    if root.sub != "": Text {
        text: root.sub;
        color: root.sub-color;
        font-size: 12.5px;
        overflow: elide;
    }
}

component Dot inherits Rectangle {
    // 0 green, 1 amber, 2 grey
    in property <int> state;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: self.state == 0 ? T.ok : self.state == 1 ? T.warn : T.faint;
}

component Seg inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    in property <bool> enabled: true;
    callback changed(int);
    height: 40px;
    border-radius: 10px;
    border-width: 1px;
    border-color: T.border;
    background: T.s2;
    opacity: self.enabled ? 1 : 0.5;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for o[i] in root.options: Rectangle {
            horizontal-stretch: 1;
            border-radius: 7px;
            background: root.current == i ? T.s3 : transparent;
            border-width: root.current == i ? 1px : 0px;
            border-color: T.border;
            accessible-role: button;
            accessible-label: o;
            accessible-checked: root.current == i;
            accessible-action-default => {
                if (root.enabled) {
                    root.changed(i);
                }
            }
            Text {
                width: 100%;
                height: 100%;
                text: o;
                color: root.current == i ? T.text : T.muted;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => {
                    root.changed(i);
                }
            }
        }
    }
}

// An on/off switch (the update check).
component Switch inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    callback toggled;
    width: 36px;
    height: 20px;
    border-radius: 10px;
    border-width: 1px;
    border-color: self.on ? T.accent : T.border;
    background: self.on ? T.accent : T.s3;
    accessible-role: switch;
    accessible-label: self.label;
    accessible-checked: self.on;
    accessible-action-default => {
        root.toggled();
    }
    Rectangle {
        x: root.on ? 18px : 2px;
        y: 2px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.on ? #ffffff : T.muted;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggled();
        }
    }
}

component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> password;
    in property <bool> enabled: true;
    in property <string> font-family;
    callback edited(string);
    callback accepted(string);
    height: 40px;
    border-radius: 8px;
    border-width: 1px;
    border-color: ti.has-focus ? T.accent : T.border;
    background: T.s2;
    opacity: self.enabled ? 1 : 0.5;
    ti := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: 100%;
        vertical-alignment: center;
        single-line: true;
        text <=> root.text;
        enabled: root.enabled;
        color: T.text;
        font-size: 14px;
        font-family: root.font-family;
        selection-background-color: #6b8afe66;
        input-type: root.password ? InputType.password : InputType.text;
        accessible-label: root.label != "" ? root.label : root.placeholder;
        edited => {
            root.edited(self.text);
        }
        accepted => {
            root.accepted(self.text);
        }
    }
    if root.text == "": Text {
        x: 12px;
        width: parent.width - 24px;
        height: 100%;
        vertical-alignment: center;
        text: root.placeholder;
        color: T.faint;
        font-size: 14px;
        overflow: elide;
        accessible-role: none;
    }

    public function focus-field() {
        ti.focus();
    }
}

component LabeledField inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password;
    in property <bool> enabled: true;
    in property <string> font-family;
    callback edited(string);
    spacing: 6px;
    Text {
        text: root.label;
        color: T.muted;
        font-size: 12.5px;
    }
    Field {
        text <=> root.text;
        label: root.label;
        placeholder: root.placeholder;
        password: root.password;
        enabled: root.enabled;
        font-family: root.font-family;
        edited(t) => {
            root.edited(t);
        }
    }
}

// The landing page's six-box code, big or small.
component CodeBoxes inherits HorizontalLayout {
    in property <[string]> chars;
    in property <bool> small;
    in property <string> font-family;
    in property <bool> hot;
    spacing: self.small ? 6px : 8px;
    alignment: center;
    for c in root.chars: Rectangle {
        width: root.small ? 34px : 50px;
        height: root.small ? 40px : 58px;
        border-radius: root.small ? 8px : 10px;
        border-width: 1px;
        border-color: root.hot ? T.accent-line : T.border;
        background: T.s2;
        Text {
            text: c;
            color: T.text;
            font-size: root.small ? 18px : 27px;
            font-weight: 600;
            font-family: root.font-family;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// docs/64 D17, code option 1: the six boxes are one copy target. Hover and
// keyboard focus draw the accent tint and outline, a copy icon after the
// last box and a "Click to copy" tooltip; focus adds the ring; a click
// copies, and for 1.2 s the icon is a green check under a "Copied" tooltip.
component CopyCode inherits Rectangle {
    in property <[string]> chars;
    in property <string> code;
    in property <string> font-family;
    callback copy;
    property <bool> hot: ta.has-hover || fs.has-focus;
    property <bool> flash;
    width: row.preferred-width;
    height: row.preferred-height;
    border-radius: 14px;
    border-width: 1px;
    border-color: self.hot || self.flash ? T.accent-line : transparent;
    background: self.hot || self.flash ? T.accent-hover : transparent;
    accessible-role: button;
    accessible-label: "Copy code " + self.code;
    accessible-action-default => {
        root.do-copy();
    }
    function do-copy() {
        root.copy();
        root.flash = true;
        flash-timer.restart();
    }
    // Bound to flash: restart() alone never starts a stopped Timer, which
    // left "Copied" up for good.
    flash-timer := Timer {
        interval: 1200ms;
        running: root.flash;
        triggered => {
            root.flash = false;
        }
    }
    if fs.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 16px;
        border-width: 2px;
        border-color: T.accent;
    }
    row := HorizontalLayout {
        padding: 8px;
        spacing: 10px;
        cross-axis-alignment: center;
        CodeBoxes {
            chars: root.chars;
            font-family: root.font-family;
            hot: root.hot || root.flash;
        }
        Rectangle {
            width: 18px;
            height: 18px;
            if root.flash: Icon {
                commands: Icons.check;
                ink: T.ok;
            }
            if root.hot && !root.flash: Icon {
                commands: Icons.copy;
                ink: T.accent-text;
            }
        }
    }
    if root.hot || root.flash: Tip {
        text: root.flash ? "Copied" : "Click to copy";
        done: root.flash;
        x: (parent.width - self.width) / 2;
        y: -self.height - 8px;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.do-copy();
        }
    }
    // Keyboard focus only: focusing on click would swallow the first press
    // before the TouchArea under it saw a click.
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.do-copy();
                return accept;
            }
            return reject;
        }
    }
}

// docs/64 D17, link option A: hover gives the link an accent-tinted pill, a
// copy icon and a "Click to copy" tooltip; a click copies, and for 1.2 s it
// shows a check and "Copied".
component CopyLink inherits Rectangle {
    in property <string> text;
    in property <string> font-family;
    callback copy;
    property <bool> hot: ta.has-hover || fs.has-focus;
    property <bool> flash;
    in property <length> widest: 480px;
    horizontal-stretch: 0;
    width: Math.min(row.preferred-width, self.widest);
    height: 28px;
    border-radius: 10px;
    border-width: 1px;
    border-color: self.hot || self.flash ? T.accent-line : transparent;
    background: self.hot || self.flash ? T.accent-hover : transparent;
    accessible-role: button;
    accessible-label: "Copy link " + self.text;
    accessible-action-default => {
        root.do-copy();
    }
    function do-copy() {
        root.copy();
        root.flash = true;
        flash-timer.restart();
    }
    // Bound to flash: restart() alone never starts a stopped Timer, which
    // left "Copied" up for good.
    flash-timer := Timer {
        interval: 1200ms;
        running: root.flash;
        triggered => {
            root.flash = false;
        }
    }
    if fs.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 12px;
        border-width: 2px;
        border-color: T.accent;
    }
    row := HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 6px;
        cross-axis-alignment: center;
        Text {
            text: root.text;
            color: root.hot || root.flash ? T.text : T.muted;
            font-size: 12.5px;
            font-family: root.font-family;
            overflow: elide;
        }
        if root.flash: Icon {
            commands: Icons.check;
            ink: T.ok;
            size: 13px;
        }
        if root.hot && !root.flash: Icon {
            commands: Icons.copy;
            ink: T.accent-text;
            size: 13px;
        }
    }
    if root.hot || root.flash: Tip {
        text: root.flash ? "Copied" : "Click to copy";
        done: root.flash;
        x: (parent.width - self.width) / 2;
        y: -self.height - 6px;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.do-copy();
        }
    }
    // Keyboard focus only: focusing on click would swallow the first press
    // before the TouchArea under it saw a click.
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.do-copy();
                return accept;
            }
            return reject;
        }
    }
}

component Meter inherits HorizontalLayout {
    in property <float> level;
    spacing: 2px;
    cross-axis-alignment: end;
    height: 14px;
    for i in 10: Rectangle {
        width: 3px;
        height: 4px + 10px * Math.min(1, (i + 1) / 10);
        border-radius: 1px;
        background: root.level * 10 > i ? T.ok : T.s3;
    }
}

component Avatar inherits Rectangle {
    in property <string> initial;
    in property <int> tint;
    in property <bool> ring;
    in property <bool> speaking;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: T.tint(self.tint);
    border-width: self.speaking ? 2px : 0px;
    border-color: T.ok;
    if root.ring: Rectangle {
        x: -4px;
        y: -4px;
        width: 38px;
        height: 38px;
        border-radius: 19px;
        border-width: 2px;
        border-color: T.accent;
    }
    Text {
        text: root.initial;
        color: #0a0b0d;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A notice with its fix (docs/60 D13, docs/64 D4).
component Banner inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> icon;
    in property <bool> warn: true;
    in property <string> action;
    in property <bool> dismissible: true;
    callback act;
    callback dismiss;
    vertical-stretch: 0;
    border-radius: 12px;
    border-width: 1px;
    border-color: self.warn ? T.warn-line : T.accent-line;
    background: self.warn ? T.warn-soft : T.accent-soft;
    HorizontalLayout {
        padding: 12px;
        padding-left: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: start;
            Icon {
                commands: root.icon;
                ink: root.warn ? T.warn-text : T.accent-text;
            }
        }
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            Text {
                text: root.title == "" ? root.body : root.title + " " + root.body;
                color: T.text;
                font-size: 13px;
                wrap: word-wrap;
            }
            if root.action != "" || root.dismissible: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if root.action != "": Btn {
                    text: root.action;
                    small: true;
                    clicked => {
                        root.act();
                    }
                }
                if root.dismissible: Btn {
                    text: "Dismiss";
                    kind: 2;
                    small: true;
                    clicked => {
                        root.dismiss();
                    }
                }
            }
        }
    }
}

// The update notice (docs/47 D7, docs/48 D4), at the top of Ready with the
// other notices (docs/60 D13). A banner with the summary card's header —
// a kicker and Dismiss — so its two buttons fit the narrowest window.
component UpdateCard inherits Rectangle {
    in property <string> version;
    // MainWindow's update-phase: 0 the release page, 1 downloading, 2 ready.
    in property <int> phase;
    // Starting or live: never install then (docs/48 D4).
    in property <bool> busy;
    in property <string> note;
    callback install;
    callback open-release;
    callback dismiss;
    vertical-stretch: 0;
    border-radius: 12px;
    border-width: 1px;
    border-color: T.accent-line;
    background: T.accent-soft;
    HorizontalLayout {
        padding: 12px;
        padding-left: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: start;
            // Centred on the 32 px header row.
            padding-top: 7px;
            Icon {
                commands: Icons.download;
                ink: T.accent-text;
            }
        }
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            HorizontalLayout {
                cross-axis-alignment: center;
                Kicker {
                    text: root.phase == 2 ? "UPDATE READY" : "UPDATE AVAILABLE";
                    color: T.accent-text;
                    horizontal-stretch: 1;
                }
                Btn {
                    kind: 2;
                    small: true;
                    icon: Icons.close;
                    text: "Dismiss";
                    clicked => {
                        root.dismiss();
                    }
                }
            }
            Text {
                text: root.phase == 2 ? (root.busy ? "gawk " + root.version + " is ready. Install it once you've stopped broadcasting."
                    : "gawk " + root.version + " is downloaded and verified. Installing it takes a few seconds and reopens the app.")
                    : root.phase == 1 ? "Downloading gawk " + root.version + ". You can install it in a moment."
                    : "gawk " + root.version + " is available.";
                color: T.text;
                font-size: 13px;
                wrap: word-wrap;
            }
            if root.note != "": Text {
                text: root.note;
                color: T.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if root.phase == 2: Btn {
                    text: "Install and relaunch";
                    small: true;
                    enabled: !root.busy;
                    clicked => {
                        root.install();
                    }
                }
                if root.phase == 0: Btn {
                    text: "Download";
                    icon: Icons.external;
                    small: true;
                    clicked => {
                        root.open-release();
                    }
                }
                if root.phase != 0: Btn {
                    text: "What's new";
                    kind: 2;
                    icon: Icons.external;
                    small: true;
                    clicked => {
                        root.open-release();
                    }
                }
            }
        }
    }
}

// A bottom sheet over the page: scrim, grab handle, title and close.
component Sheet inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <length> sheet-height: 620px;
    callback close;
    background: T.scrim;
    TouchArea {
        clicked => {
            root.close();
        }
    }
    Rectangle {
        y: parent.height - self.height;
        height: Math.min(root.sheet-height, parent.height - 40px);
        background: T.s1;
        border-radius: 20px;
        border-width: 1px;
        border-color: T.border;
        // Eats clicks so they don't reach the scrim.
        TouchArea { }
        VerticalLayout {
            padding: 20px;
            padding-top: 8px;
            spacing: 14px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 36px;
                    height: 4px;
                    border-radius: 2px;
                    background: T.border;
                }
            }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text {
                        text: root.title;
                        color: T.text;
                        font-size: 17px;
                        font-weight: 600;
                    }
                    if root.subtitle != "": Text {
                        text: root.subtitle;
                        color: T.muted;
                        font-size: 12.5px;
                        wrap: word-wrap;
                    }
                }
                IconBtn {
                    icon: Icons.close;
                    label: "Close";
                    clicked => {
                        root.close();
                    }
                }
            }
            @children
        }
    }
}

// A centred card over a scrim, for questions that block (docs/60 D10, D13).
component Modal inherits Rectangle {
    in property <length> card-width: 420px;
    background: T.scrim;
    TouchArea { }
    Rectangle {
        width: Math.min(root.card-width, parent.width - 48px);
        height: box.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: T.s1;
        border-radius: 16px;
        border-width: 1px;
        border-color: T.border;
        box := VerticalLayout {
            padding: 24px;
            spacing: 14px;
            @children
        }
    }
}

// A key/value list (Details).
component Stats inherits Rectangle {
    in property <[StatRow]> rows;
    vertical-stretch: 0;
    background: T.s1;
    border-radius: 12px;
    border-width: 1px;
    border-color: T.border;
    VerticalLayout {
        padding: 12px;
        padding-left: 14px;
        spacing: 6px;
        alignment: start;
        for row in root.rows: HorizontalLayout {
            spacing: 12px;
            Text {
                text: row.label;
                color: T.muted;
                font-size: 12.5px;
                width: 40%;
            }
            Text {
                text: row.value;
                color: T.text;
                font-size: 12.5px;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
        }
    }
}

// The header's server status (docs/64 D1): text, not a button. Green only
// after a probe answered. 0 checking, 1 connected, 2 unreachable
component StatusLine inherits HorizontalLayout {
    in property <int> state;
    in property <string> rtt;
    horizontal-stretch: 0;
    spacing: 7px;
    padding-left: 6px;
    padding-right: 6px;
    cross-axis-alignment: center;
    accessible-role: text;
    accessible-label: self.state == 1 ? "Connected to the server, " + self.rtt : self.state == 2 ? "Can't reach the server" : "Checking the server";
    Dot {
        state: root.state == 1 ? 0 : root.state == 2 ? 1 : 2;
    }
    Text {
        text: root.state == 1 ? "Connected" : root.state == 2 ? "Can't reach server" : "Checking…";
        color: root.state == 2 ? T.warn-text : T.muted;
        font-size: 12.5px;
    }
    if root.state == 1 && root.rtt != "": Text {
        text: root.rtt;
        color: T.faint;
        font-size: 12.5px;
    }
}

// docs/64 D3: a non-default server is always in view on Ready, Paused and
// Live — docs/40 F2's in-session indicator. Not dismissible.
component ServerStrip inherits Rectangle {
    in property <string> name;
    in property <string> host;
    in property <string> note;
    in property <string> mono-font;
    callback change;
    vertical-stretch: 0;
    border-radius: 12px;
    border-width: 1px;
    border-color: T.warn-line;
    background: T.warn-soft;
    accessible-role: text;
    accessible-label: "Using server " + self.name + ", " + self.host;
    HorizontalLayout {
        padding: 8px;
        padding-left: 12px;
        spacing: 10px;
        cross-axis-alignment: center;
        Icon {
            commands: Icons.server;
            ink: T.warn-text;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            Text {
                text: "Using server: " + root.name;
                color: T.text;
                font-size: 13px;
                overflow: elide;
            }
            Text {
                text: root.host;
                color: T.warn-text;
                font-size: 12px;
                font-family: root.mono-font;
                overflow: elide;
            }
            if root.note != "": Text {
                text: root.note;
                color: T.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        RowLink {
            text: "Change";
            clicked => {
                root.change();
            }
        }
    }
}

// docs/66 D4: a problem viewers feel right now, as one line pinned under the
// header, with its fix. Never dismissible (docs/57 OD7).
component AlertStrip inherits Rectangle {
    in property <string> text;
    in property <string> action;
    callback act;
    vertical-stretch: 0;
    height: 44px;
    border-radius: 12px;
    border-width: 1px;
    border-color: T.warn-line;
    background: T.warn-soft;
    accessible-role: AccessibleRole.text;
    accessible-label: self.text;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 10px;
        cross-axis-alignment: center;
        Icon {
            commands: Icons.alert;
            ink: T.warn-text;
        }
        Text {
            text: root.text;
            color: T.text;
            font-size: 13px;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.action != "": RowLink {
            text: root.action;
            clicked => {
                root.act();
            }
        }
    }
}

// One tile of the summary card: a value over what it means.
component StatTile inherits Rectangle {
    in property <string> value;
    in property <string> label;
    horizontal-stretch: 1;
    border-radius: 10px;
    background: #0a0b0d66;
    VerticalLayout {
        padding: 10px;
        spacing: 3px;
        Text {
            text: root.value;
            color: T.text;
            font-size: 15px;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: root.label;
            color: T.muted;
            font-size: 11.5px;
            overflow: elide;
        }
    }
}

// The room card (docs/64 D6): what a room adds to Live, in place of the Room
// list's one row. Nothing else on the page changes.
component RoomCard inherits List {
    in property <LiveView> v;
    in-out property <string> room-key-input;
    callback open-link(string);
    callback copy-room-link();
    callback manage();
    callback leave();
    callback key-submit();
    // Near the window's minimum width and in the wide layout's column the
    // three actions don't fit one row: Leave room gets its own, still in
    // view (docs/64 OD6). The window decides — the card can't measure
    // itself for a layout that sets its own width.
    in property <bool> tight;
    HorizontalLayout {
        height: 44px;
        padding-left: 16px;
        padding-right: 10px;
        spacing: 8px;
        cross-axis-alignment: center;
        Kicker {
            text: root.v.room-code != "" ? "ROOM " + root.v.room-code : "ROOM";
            horizontal-stretch: 0;
        }
        Text {
            text: root.v.room-streaming + " streaming · " + root.v.room-watching + " watching";
            color: T.muted;
            font-size: 12.5px;
            horizontal-stretch: 1;
            horizontal-alignment: right;
            overflow: elide;
        }
        RowLink {
            text: "Manage";
            clicked => {
                root.manage();
            }
        }
    }
    if root.v.room-needs-key: Row {
        tinted: true;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            padding-top: 4px;
            padding-bottom: 4px;
            Text {
                text: "This room needs a key to add your stream. You're watching until then.";
                color: T.text;
                font-size: 13px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                Field {
                    horizontal-stretch: 1;
                    label: "Room key";
                    placeholder: "Room key";
                    password: true;
                    text <=> root.room-key-input;
                    accepted => {
                        root.key-submit();
                    }
                }
                Btn {
                    text: "Add my stream";
                    enabled: root.room-key-input != "";
                    clicked => {
                        root.key-submit();
                    }
                }
            }
        }
    }
    for r in root.v.room-rows: Row {
        Avatar {
            initial: r.initial;
            tint: r.tint;
            ring: r.you;
            speaking: r.speaking;
        }
        RowText {
            title: r.you ? r.name + " (you)" : r.name;
            sub: r.detail;
            sub-color: r.away ? T.warn-text : T.muted;
        }
        if !r.you && r.watch-link != "": RowLink {
            text: "Watch";
            icon: Icons.external;
            chevron: false;
            clicked => {
                root.open-link(r.watch-link);
            }
        }
    }
    if root.v.room-watchers != "": Row {
        HorizontalLayout {
            spacing: -6px;
            for w[i] in root.v.room-watcher-initials: Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                border-width: 2px;
                border-color: T.s1;
                // The fourth bubble is the "+N" overflow.
                background: i == 3 ? #3a3f4b : T.tint(i + 3);
                Text {
                    text: w;
                    color: i == 3 ? T.text : #0a0b0d;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.v.room-watchers;
            color: T.muted;
            font-size: 12.5px;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
    if root.v.room-status != "": Row {
        Text {
            text: root.v.room-status;
            color: T.muted;
            font-size: 12.5px;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }
    }
    Row {
        Btn {
            kind: 4;
            small: true;
            icon: Icons.link;
            text: "Copy room link";
            confirm: true;
            enabled: root.v.room-link != "";
            clicked => {
                root.copy-room-link();
            }
        }
        Btn {
            small: true;
            icon: Icons.external;
            text: "Open room view";
            enabled: root.v.room-link != "";
            clicked => {
                root.open-link(root.v.room-link);
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        if !root.tight: Btn {
            kind: 2;
            small: true;
            icon: Icons.leave;
            text: "Leave room";
            clicked => {
                root.leave();
            }
        }
    }
    if root.tight: Row {
        Rectangle {
            horizontal-stretch: 1;
        }
        Btn {
            kind: 2;
            small: true;
            icon: Icons.leave;
            text: "Leave room";
            clicked => {
                root.leave();
            }
        }
    }
}

// The Live page's code, rows and room: below the preview in a narrow window,
// a right-hand column in a wide one (D7). The same component is Paused
// (docs/64 D9). Its buttons are the page's action bar (docs/66 D2), not
// part of it. Everything it shows comes in through `v`; everything it does
// goes out through callbacks.
component LiveSide inherits VerticalLayout {
    in property <LiveView> v;
    in property <bool> wide;
    // The room card's actions need two rows (see RoomCard).
    in property <bool> tight;
    in-out property <string> room-key-input;
    callback copy-code();
    callback copy-link();
    callback copy-room-link();
    callback open-link(string);
    callback change-source();
    callback change-quality();
    callback open-room-sheet();
    callback room-key-submit();
    callback open-details();
    callback leave-room();
    callback rejoin-room();
    callback dismiss-pending();
    spacing: 14px;
    alignment: start;

    // The code: six boxes and the link, or a wait while the relay mints it.
    VerticalLayout {
        spacing: 8px;
        padding-top: 4px;
        if root.v.code != "": HorizontalLayout {
            alignment: center;
            CopyCode {
                chars: root.v.code-chars;
                code: root.v.code;
                font-family: root.v.mono-font;
                copy => {
                    root.copy-code();
                }
            }
        }
        if root.v.code != "" && root.v.join-link != "": HorizontalLayout {
            alignment: center;
            CopyLink {
                text: root.v.join-link;
                font-family: root.v.mono-font;
                copy => {
                    root.copy-link();
                }
            }
        }
        if root.v.code == "": Text {
            text: "Getting your code…";
            color: T.muted;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }

    // D5: the stream list, the same alone and in a room.
    Kicker {
        text: "YOUR STREAM";
    }
    List {
        Row {
            first: true;
            RowIco {
                icon: root.v.sharing-window ? Icons.window : Icons.monitor;
            }
            RowText {
                title: root.v.sharing-title != "" ? root.v.sharing-title : "Nothing chosen yet";
                sub: root.v.sharing-detail;
            }
            if root.v.sharing-can-change: RowLink {
                text: "Change";
                clicked => {
                    root.change-source();
                }
            }
        }
        Row {
            RowIco {
                icon: Icons.speaker;
            }
            RowText {
                title: root.v.audio-line != "" ? root.v.audio-line : "Sound";
            }
            Meter {
                level: root.v.paused ? 0 : root.v.audio-level;
            }
        }
        Row {
            RowIco {
                icon: Icons.gauge;
            }
            RowText {
                title: root.v.quality-title;
                sub: root.v.quality-detail;
            }
            RowLink {
                text: "Change";
                clicked => {
                    root.change-quality();
                }
            }
        }
        Row {
            RowIco {
                icon: Icons.signal;
            }
            RowText {
                title: root.v.upload-title;
                sub: root.v.upload-detail;
            }
            Dot {
                state: root.v.upload-state;
            }
            // docs/66 D3: Details is about the connection; the wide window
            // shows it inline instead.
            if !root.wide: RowLink {
                text: "Details";
                clicked => {
                    root.open-details();
                }
            }
        }
    }

    // D6: the Room list's one row, or the room card in its place.
    if !root.v.room-active: List {
        Row {
            first: true;
            tinted: root.v.room-pending != "";
            RowIco {
                icon: Icons.users;
                accent: root.v.room-pending != "";
            }
            RowText {
                title: root.v.room-pending != "" ? "Room " + root.v.room-pending : "Room";
                sub: root.v.room-pending != "" ? root.v.room-pending-detail
                    : root.v.room-left != "" ? "You left " + root.v.room-left
                    : root.v.room-status != "" ? root.v.room-status : "Not in a room";
            }
            if root.v.room-pending == "" && root.v.room-left != "": Btn {
                small: true;
                text: "Rejoin";
                clicked => {
                    root.rejoin-room();
                }
            }
            if root.v.room-pending == "": RowLink {
                text: "Add";
                clicked => {
                    root.open-room-sheet();
                }
            }
            if root.v.room-pending != "": IconBtn {
                icon: Icons.close;
                label: "Don't join " + root.v.room-pending;
                box: 32px;
                clicked => {
                    root.dismiss-pending();
                }
            }
        }
    }
    if root.v.room-active: RoomCard {
        v: root.v;
        tight: root.tight;
        room-key-input <=> root.room-key-input;
        open-link(l) => {
            root.open-link(l);
        }
        copy-room-link => {
            root.copy-room-link();
        }
        manage => {
            root.open-room-sheet();
        }
        leave => {
            root.leave-room();
        }
        key-submit => {
            root.room-key-submit();
        }
    }
}

export component MainWindow inherits Window {
    title: "gawk";
    // The title-bar and taskbar icon (R44, docs/53 D6): the shared mark,
    // embedded into the binary by slint-build, so the EXE stays a single file.
    icon: @image-url("../../../assets/icon/png/gawk-256.png");
    background: T.bg;
    preferred-width: 520px;
    preferred-height: 800px;
    min-width: 440px;
    min-height: 600px;

    // ----- header / identity -----
    // The build version ("v1.0.0+g1a2b3c4"): the question it answers — "is
    // the EXE you are looking at the one I fixed?" — is asked about a
    // screenshot, so it stays on the first page.
    in property <string> app-version: "";
    // A newer release (R45, docs/47 D7): "v2.1.0", blank = nothing to say,
    // and its release page (prefix-checked by the engine before it gets here).
    in property <string> update-version: "";
    in property <string> update-url: "";
    // R47 (docs/48 D4): what the notice offers — 0 the release page, 1 the
    // install is downloading, 2 it is verified: "Install and relaunch"; and
    // the line under it — the .deb instructions (D9) or why this copy won't
    // update itself.
    in property <int> update-phase: 0;
    in property <string> update-note: "";
    // The Settings "Check now" button: in flight, and what it last found.
    in property <bool> update-checking: false;
    in property <string> update-status: "";
    in property <string> state-label: "Not broadcasting";
    in property <bool> live: false;
    in property <bool> busy: false;            // starting, live or paused
    in property <bool> resuming: false;
    in property <string> status-line: "";      // "Reconnecting… (attempt N)"
    in property <string> live-elapsed: "";
    in property <int> watching: 0;
    in property <bool> watching-known: false;

    // ----- the server (docs/64 D1–D3) -----
    // 0 checking, 1 connected, 2 can't reach
    in property <int> probe-state: 0;
    in property <string> probe-rtt: "";
    in property <string> probe-host: "";
    in property <bool> server-custom: false;
    in property <string> server-name: "";
    in property <string> server-host: "";
    in property <string> server-note: "";

    // ----- paused (docs/64 D9, D11) -----
    in property <bool> paused: false;
    in property <string> paused-elapsed: "";
    // The app died live: Paused with a banner and no session yet.
    in property <bool> crash-resume: false;

    // ----- live readouts -----
    in property <string> encode-line: "";      // the Details line
    in property <string> sharing-title: "";
    in property <string> sharing-detail: "";
    in property <bool> sharing-window: false;
    in property <string> live-quality: "";      // "1080p · 60 fps"
    in property <string> live-quality-detail: ""; // "H.264 hardware · up to 12 Mbps"
    in property <string> audio-line: "";
    in property <float> audio-level: 0.0;
    in property <bool> audio-hint: false;
    in property <string> audio-hint-text: "";
    in property <string> minimized-hint: "";
    in property <string> uplink-warning: "";
    // docs/57 D7: "Your Wi-Fi is dropping some video…" — the shell owns
    // when it shows, dismissal included (it counts across broadcasts).
    in property <string> network-notice: "";
    in property <string> connection-line: "";
    in property <bool> connection-ok: true;
    in property <string> upload-host: "";

    // ----- code -----
    in property <string> code: "";
    in property <[string]> code-chars: [];
    in property <string> join-link: "";
    in property <string> copied-note: "";

    // ----- ready rows -----
    in property <string> quality-line: "";
    in property <string> quality-title: "";     // Paused's Quality row
    in property <string> quality-detail: "";

    // ----- rooms (docs/44, docs/60 D8–D10, docs/64 D6) -----
    in-out property <string> room-input: "";       // the sheet's code-or-link field
    in property <string> room-input-echo: "";      // what the field was read as
    in property <bool> room-input-ok: false;
    in-out property <string> room-nickname: "";
    in property <string> room-pending: "";         // joins/creates when live
    in property <string> room-pending-detail: "";
    in property <bool> room-active: false;         // a room control session exists
    in property <bool> room-attached: false;
    in property <string> room-code: "";
    in property <string> room-status: "";
    in property <string> room-link: "";
    in property <bool> room-creator: false;
    in property <int> room-streaming: 0;
    in property <int> room-watching: 0;
    in property <[RoomRow]> room-rows: [];
    in property <string> room-watchers: "";
    in property <[string]> room-watcher-initials: [];
    in property <bool> room-needs-key: false;
    in-out property <string> room-key-input: "";
    in property <[RecentRow]> recent-rooms: [];
    in property <string> room-card-title: "";
    in property <string> room-card-body: "";
    in property <string> room-left: "";            // left just now: Rejoin
    in-out property <bool> show-room-sheet: false;
    in-out property <bool> editing-name: false;

    // ----- thumbnail -----
    in property <image> thumbnail;
    in property <bool> show-thumbnail: false;
    // Ready's preview of the chosen source (docs/65 D2): its own pair, so
    // Live's thumbnail never shows a stale Ready picture or vice versa.
    in property <image> preview;
    in property <bool> has-preview: false;

    // ----- error -----
    in property <string> error-text: "";
    in property <bool> can-mint: false;

    // ----- share (macOS, Linux: docs/54 D11, docs/58 D9) -----
    // True where content is chosen in the system's picker (macOS:
    // SCContentSharingPicker, docs/54 D4; Linux: the portal): the Share card
    // replaces the Windows picker page and lists nothing itself.
    in property <bool> system-picker: false;
    in property <string> share-summary: "";      // what was picked; empty = nothing yet
    in property <string> share-mode-label: "";   // "this app's audio" / "whole-system audio"
    in property <bool> share-window: false;       // the pick was one window (the card's icon)
    in property <bool> share-picker-available: true;
    // What the Share card says before anything is picked: the platform's
    // picker is its own (macOS: SCContentSharingPicker; Linux: the portal).
    in property <string> share-empty-hint: "macOS shows its own picker. Choose one app window or a whole display.";
    // The in-window menu bar (macOS only; split from system-picker for
    // Linux, which has the Share card but no menu bar — docs/58 D9).
    in property <bool> native-menu: false;

    // ----- whose audio (Linux, docs/58 D9 — docs/39 D5's card) -----
    // Shown after a WINDOW pick, before Start: the portal never says whose
    // window it was, so the user names whose sound goes out.
    in property <bool> whose-audio: false;
    in property <[AudioAppRow]> audio-apps: [];
    // Index into audio-apps; -1 = whole system, -2 = no audio.
    in-out property <int> audio-choice: -1;
    in-out property <bool> show-audio-sheet: false;

    // The code face. Consolas is a Windows font; macOS sets Menlo.
    in property <string> mono-font: "Consolas";

    // ----- picker (Windows) -----
    in property <[WindowRow]> windows: [];
    in property <[MonitorRow]> monitors: [];
    // The chosen source: what a start captures (docs/64 D14). Only the
    // picker's Share this / Switch commits to these.
    in-out property <int> picker-tab: 0;
    in-out property <int> selected-window: -1;
    in-out property <int> selected-monitor: -1;
    // The picker page's draft: the tab being looked at and the row clicked.
    // Back and Cancel drop it.
    in-out property <int> draft-tab: 0;
    in-out property <int> draft-window: -1;
    in-out property <int> draft-monitor: -1;

    // ----- resume and the ended summary (docs/64 D10) -----
    in property <string> resume-code: "";
    in property <bool> summary-visible: false;
    in property <[StatRow]> summary-rows: [];

    // ----- pages: 0 main, 1 picker, 2 settings, 3 edit server, 4 quality -----
    in-out property <int> page: 0;

    // ----- settings -----
    // R37 SP9 server profiles: index 0 is always the built-in default relay,
    // then one entry per saved custom server. The shell owns the mapping.
    in property <[string]> server-labels: ["Official server"];
    in property <[string]> server-urls: [];
    in-out property <int> set-server: 0;
    // The Edit server page's server (docs/64 D15): its own, not the selected
    // one — Edit never switches servers.
    in property <bool> server-is-custom: false;
    in-out property <string> set-server-name: "";
    in-out property <string> set-relay: "";
    in-out property <string> set-app-url: "";
    in-out property <string> set-secret: "";
    in-out property <string> set-bitrate: "";
    in-out property <string> set-telemetry: "";
    // Test connection: 0 not run, 1 running, 2 reachable, 3 can't reach
    in property <int> test-state: 0;
    in property <string> test-result: "";
    in property <string> default-relay: "";
    in-out property <int> set-resolution: 1;   // index into labels below
    in-out property <int> set-framerate: 1;
    in property <[string]> resolution-labels: ["1440p", "1080p", "720p", "480p", "Custom"];
    in-out property <string> set-custom-width: "";
    in-out property <string> set-custom-height: "";
    in-out property <bool> set-update-check: true;
    in property <[string]> framerate-labels: ["120 fps", "60 fps", "30 fps", "5 fps"];
    in property <string> caption-broadcast: "";
    in property <string> caption-diag: "";
    in property <string> terms-link: "";
    in-out property <bool> show-links-sheet: false;
    in-out property <bool> show-diag-sheet: false;

    // ----- details -----
    in-out property <bool> show-details: false;
    in property <[StatRow]> stats-rows: [];

    // ----- close confirm -----
    in-out property <bool> confirm-close: false;

    // ----- window fit (R64, docs/66 D8) -----
    // What the main page needs, as client heights: nothing scrolls with its
    // elastic element (the preview, the source card) at its minimum, and the
    // same at its natural size. And whether its body scrolls now. The pages
    // are `if` blocks the root can't reach into, so each publishes its own.
    out property <length> page-needs-min;
    out property <length> page-needs;
    out property <bool> body-scrolls;

    // Local UI state.
    property <bool> wide: self.width >= 900px;
    property <bool> audio-dismissed;
    property <bool> minimized-dismissed;
    property <bool> show-secret;
    // The Live page shows while starting, live or paused (docs/64 D9).
    property <bool> on-air: root.busy || root.paused;
    // docs/66 D4: the problem the alert slot shows, highest first. 0 none,
    // 1 reconnecting, 2 the upload can't keep up, 3 the network drops video.
    // The shell already holds the network line back while the upload one
    // shows (docs/57 D7).
    property <int> alert-kind: !root.on-air || root.paused ? 0
        : root.resuming ? 1
        : root.uplink-warning != "" ? 2
        : root.network-notice != "" ? 3 : 0;

    // docs/66 D2: Copy code is an icon when the window is narrower than the
    // Live bar with it labelled, as the bar measures it in this font. Set
    // from `changed`, not bound: a binding would make the window's width
    // constraints depend on its own width (a binding loop).
    property <length> bar-labelled: 500px;
    property <bool> narrow-bar: true;
    init => {
        root.narrow-bar = self.width < root.bar-labelled;
    }
    changed width => {
        root.narrow-bar = self.width < root.bar-labelled;
    }
    changed bar-labelled => {
        root.narrow-bar = self.width < root.bar-labelled;
    }

    function publish-fit(needs-min: length, needs: length, scrolls: bool) {
        root.page-needs-min = needs-min;
        root.page-needs = needs;
        root.body-scrolls = scrolls;
    }

    // What the next start shares (Ready's card, Paused's Sharing row): the
    // committed selection on Windows, the system picker's pick elsewhere.
    property <bool> has-window: !root.system-picker && root.picker-tab == 0 && root.selected-window >= 0 && root.selected-window < root.windows.length;
    property <bool> has-monitor: !root.system-picker && root.picker-tab == 1 && root.selected-monitor >= 0 && root.selected-monitor < root.monitors.length;
    property <bool> has-pick: root.system-picker && root.share-summary != "";
    property <string> next-source: root.has-window ? root.windows[root.selected-window].title
        : root.has-monitor ? root.monitors[root.selected-monitor].label
        : root.has-pick ? root.share-summary : "";
    property <bool> next-is-window: root.has-window || (root.has-pick && root.share-window);
    property <bool> can-change-source: !root.system-picker || root.share-picker-available;

    property <LiveView> lv: {
        live: root.live,
        paused: root.paused,
        starting: root.busy && !root.live && !root.paused,
        resuming: root.resuming,
        code: root.code,
        code-chars: root.code-chars,
        join-link: root.join-link,
        mono-font: root.mono-font,
        // Live shows what is being sent; Paused, what Resume will send.
        sharing-title: root.paused ? root.next-source : root.sharing-title,
        sharing-detail: root.paused ? (root.next-is-window ? "Window" : root.next-source != "" ? "Display" : "") : root.sharing-detail,
        sharing-window: root.paused ? root.next-is-window : root.sharing-window,
        sharing-can-change: root.can-change-source && !(root.busy && !root.live && !root.paused),
        audio-line: root.paused ? "Sound" : root.audio-line,
        audio-level: root.audio-level,
        quality-title: root.paused || root.live-quality == "" ? root.quality-title : root.live-quality,
        quality-detail: root.paused || root.live-quality == "" ? root.quality-detail : root.live-quality-detail,
        upload-title: root.paused ? "Paused" : root.resuming ? "Reconnecting" : !root.live ? "Starting" : root.connection-ok ? "Upload steady" : "Upload is struggling",
        upload-detail: root.paused ? "Nothing is sent until you resume"
            : root.live && root.connection-line != "" ? root.connection-line + (root.upload-host != "" ? " to " + root.upload-host : "") : "",
        upload-state: root.paused || !root.live ? 2 : root.resuming || !root.connection-ok ? 1 : 0,
        room-active: root.room-active,
        room-code: root.room-code,
        room-link: root.room-link,
        room-status: root.room-status,
        room-creator: root.room-creator,
        room-streaming: root.room-streaming,
        room-watching: root.room-watching,
        room-rows: root.room-rows,
        room-watchers: root.room-watchers,
        room-watcher-initials: root.room-watcher-initials,
        room-needs-key: root.room-needs-key,
        room-pending: root.room-pending,
        room-pending-detail: root.room-pending-detail,
        room-left: root.room-left,
    };

    // The picker page, opened from Ready's card or Live's Sharing row: the
    // draft starts from the chosen source.
    public function open-picker() {
        root.draft-tab = root.picker-tab;
        root.draft-window = root.selected-window;
        root.draft-monitor = root.selected-monitor;
        root.page = 1;
    }

    // The picker page's tabs: which list the user is looking at. It never
    // changes what is chosen (docs/64 D14).
    public function view-picker-tab(tab: int) {
        root.draft-tab = tab;
    }

    // Share this / Switch: the draft becomes the chosen source.
    function commit-picker() {
        root.picker-tab = root.draft-tab;
        root.selected-window = root.draft-tab == 0 ? root.draft-window : -1;
        root.selected-monitor = root.draft-tab == 1 ? root.draft-monitor : -1;
        root.page = 0;
        root.source-picked();
    }

    function change-source() {
        if (root.system-picker) {
            root.choose-content();
        } else {
            root.open-picker();
        }
    }

    callback refresh-picker();
    callback choose-content();
    callback source-picked();
    callback start-broadcast();
    callback resume-broadcast();
    callback pause-broadcast();
    callback stop-broadcast();
    callback copy-link();
    callback copy-code();
    callback copy-room-link();
    callback copy-diagnostics();
    callback settings-edited();
    callback server-selected();
    callback edit-server(int);
    callback add-server();
    callback remove-server();
    callback test-server();
    callback probe-now();
    callback switch-to-system-audio();
    callback network-notice-help();
    callback audio-choice-changed();
    callback room-input-edited();
    callback room-join();
    callback room-create();
    callback room-join-recent(string);
    callback room-toggle-saved(string);
    callback room-pending-dismiss();
    callback room-detach();
    callback room-rejoin();
    callback room-remove(string);
    callback room-end();
    callback room-key-submit();
    callback room-card-dismiss();
    callback room-nickname-edited();
    callback room-nickname-accepted();   // Enter or Save: rename now, no debounce
    callback summary-dismiss();
    callback resume-dismiss();
    callback open-link(string);
    callback dismiss-update();
    callback install-update();
    callback check-for-updates();
    callback quit-confirmed();

    // macOS (docs/54 D11): Slint already gives the app menu About and Quit
    // ⌘Q; this adds Settings… ⌘, beside it. Windows and Linux have no menu
    // bar (docs/58 D9).
    if root.native-menu: MenuBar {
        Menu {
            title: "Broadcast";
            MenuItem {
                title: "Settings…";
                // Slint's Control is the platform's primary modifier: ⌘ here.
                shortcut: @keys(Control + ",");
                activated => {
                    root.page = 2;
                }
            }
        }
    }

    // The soft glow behind the idle pages (the landing page's, docs/10).
    if !root.on-air && root.page == 0: Rectangle {
        x: -40px;
        y: -60px;
        width: parent.width + 80px;
        height: 380px;
        background: @radial-gradient(circle, #6b8afe1f 0%, #6b8afe00 60%);
        opacity: 0.9;
    }

    VerticalLayout {
        // ================= header =================
        HorizontalLayout {
            height: 56px;
            padding-left: root.page == 0 ? 20px : 12px;
            padding-right: 12px;
            spacing: 10px;
            cross-axis-alignment: center;

            if root.page != 0: IconBtn {
                icon: Icons.back;
                label: "Back";
                clicked => {
                    root.page = root.page == 3 ? 2 : 0;
                }
            }
            if root.page != 0: Text {
                text: root.page == 1 ? (root.live ? "Change what you share" : "Choose what to share")
                    : root.page == 2 ? "Settings"
                    : root.page == 3 ? (root.server-is-custom ? (root.set-server-name != "" ? root.set-server-name : "Server") : "Official server")
                    : "Quality";
                color: T.text;
                font-size: 17px;
                font-weight: 600;
                overflow: elide;
            }
            if root.page == 0 && !root.on-air: Image {
                source: @image-url("../../../assets/icon/png/gawk-256.png");
                width: 24px;
                height: 24px;
            }
            if root.page == 0 && !root.on-air: Text {
                text: "gawk";
                color: T.text;
                font-size: 15px;
                font-weight: 700;
                letter-spacing: 0.6px;
            }
            // LIVE, PAUSED, or the amber RECONNECTING that replaces LIVE.
            if root.page == 0 && root.on-air: Badge {
                kind: root.paused ? 1 : root.resuming ? 2 : root.live ? 0 : 3;
                elapsed: root.paused ? root.paused-elapsed : root.live-elapsed;
            }
            if root.page == 0 && root.live && !root.paused && root.watching-known: Pill {
                icon: Icons.eye;
                text: root.watching + " watching";
            }
            if root.page == 0 && root.on-air && root.room-code != "": Pill {
                kind: 1;
                icon: Icons.users;
                mono: true;
                mono-font: root.mono-font;
                text: root.room-code;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            // The live pages carry the LIVE badge too, so a broadcaster
            // changing something mid-stream sees it is still going.
            if (root.page == 1 || root.page == 4) && root.live && !root.paused: Badge {
                kind: 0;
            }
            if root.page == 1: IconBtn {
                icon: Icons.refresh;
                label: "Refresh the list";
                clicked => {
                    root.refresh-picker();
                }
            }
            if root.page == 0 && !root.on-air: StatusLine {
                state: root.probe-state;
                rtt: root.probe-rtt;
            }
            if root.page == 0: IconBtn {
                icon: Icons.settings;
                label: "Settings";
                clicked => {
                    root.page = 2;
                }
            }
        }

        // D3: a non-default server, always in view on the main page.
        if root.page == 0 && root.server-custom: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 4px;
            ServerStrip {
                name: root.server-name;
                host: root.server-host;
                note: root.server-note;
                mono-font: root.mono-font;
                change => {
                    root.page = 2;
                }
            }
        }

        // docs/66 D4: the alert slot, part of the fixed header zone.
        if root.page == 0 && root.alert-kind != 0: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 8px;
            AlertStrip {
                text: root.alert-kind == 1 ? "Reconnecting. People watching see your last frame."
                    : root.alert-kind == 2 ? "Your upload can't keep up" : root.network-notice;
                action: root.alert-kind == 2 ? "Change quality" : root.alert-kind == 3 ? "Help" : "";
                act => {
                    if (root.alert-kind == 2) {
                        root.page = 4;
                    } else {
                        root.network-notice-help();
                    }
                }
            }
        }

        // ================= ready (idle) =================
        // docs/66 D1: the body scrolls; the bar with Go live never does. The
        // source card gives up height before anything scrolls (D5).
        if root.page == 0 && !root.on-air: ready := VerticalLayout {
            vertical-stretch: 1;
            // The body but the source card: its two halves, the padding
            // (4 + 16) and the gaps either side of the card.
            property <length> rest: ready-top.preferred-height + ready-bottom.preferred-height + 48px;
            // The card's floor, natural height and ceiling. A preview (docs/65
            // D2) needs room for its picture and keeps its size; the icon card
            // can take spare height.
            property <length> card-min: root.has-preview ? 160px : 120px;
            property <length> card-natural: root.has-preview ? (root.wide ? 300px : 220px) : 150px;
            property <length> card-max: root.has-preview ? self.card-natural : 220px;
            property <length> card-h: Math.max(self.card-min, Math.min(self.card-max, ready-sv.visible-height - self.rest));
            // The header zone and the bar: the window less the body.
            property <length> chrome: root.height - ready-sv.visible-height;
            property <length> needs-min: self.chrome + self.rest + self.card-min;
            property <length> needs: self.chrome + self.rest + self.card-natural;
            property <bool> scrolls: ready-body.preferred-height > ready-sv.visible-height + 0.5px;
            property <bool> more-below: self.scrolls && ready-sv.viewport-y + ready-body.preferred-height > ready-sv.visible-height + 0.5px;
            init => {
                root.publish-fit(self.needs-min, self.needs, self.scrolls);
            }
            changed needs-min => {
                root.publish-fit(self.needs-min, self.needs, self.scrolls);
            }
            changed needs => {
                root.publish-fit(self.needs-min, self.needs, self.scrolls);
            }
            changed scrolls => {
                root.publish-fit(self.needs-min, self.needs, self.scrolls);
            }

            Rectangle {
                vertical-stretch: 1;
                ready-sv := ScrollView {
                    width: 100%;
                    height: 100%;
                    ready-body := VerticalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-top: 4px;
                        padding-bottom: 16px;
                        spacing: 14px;
                        alignment: start;

                        ready-top := VerticalLayout {
                            spacing: 14px;
                            if root.error-text != "": Rectangle {
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: T.danger-line;
                                background: T.live-soft;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;
                                    Text {
                                        text: root.error-text;
                                        color: T.text;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                    if root.can-mint: HorizontalLayout {
                                        alignment: start;
                                        Btn {
                                            text: "Start a new broadcast instead";
                                            small: true;
                                            clicked => {
                                                root.start-broadcast();
                                            }
                                        }
                                    }
                                }
                            }

                            // D2: the relay didn't answer the probe. Go live stays on.
                            if root.probe-state == 2: Banner {
                                icon: Icons.alert;
                                body: "gawk can't reach " + root.probe-host + ". Check that this computer is online. A firewall has to allow UDP to the server's port.";
                                action: "Try again";
                                dismissible: false;
                                act => {
                                    root.probe-now();
                                }
                            }

                            // docs/47 D7: in the window, not a toast — the portal and
                            // Focus Assist swallow toasts while a broadcaster games.
                            if root.update-version != "": UpdateCard {
                                version: root.update-version;
                                phase: root.update-phase;
                                busy: root.busy;
                                note: root.update-note;
                                install => {
                                    root.install-update();
                                }
                                open-release => {
                                    root.open-link(root.update-url);
                                }
                                dismiss => {
                                    root.dismiss-update();
                                }
                            }

                            // D10: the summary of the broadcast that just ended, as a
                            // passing notice with its undo.
                            if root.summary-visible: Rectangle {
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: T.accent-line;
                                background: T.accent-soft;
                                accessible-role: text;
                                accessible-label: "Broadcast ended";
                                VerticalLayout {
                                    padding: 16px;
                                    padding-top: 10px;
                                    spacing: 12px;
                                    HorizontalLayout {
                                        cross-axis-alignment: center;
                                        Kicker {
                                            text: "BROADCAST ENDED";
                                            color: T.accent-text;
                                            horizontal-stretch: 1;
                                        }
                                        Btn {
                                            kind: 2;
                                            small: true;
                                            icon: Icons.close;
                                            text: "Dismiss";
                                            clicked => {
                                                root.summary-dismiss();
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        for s in root.summary-rows: StatTile {
                                            value: s.value;
                                            label: s.label;
                                        }
                                    }
                                    if root.resume-code != "": HorizontalLayout {
                                        cross-axis-alignment: center;
                                        Text {
                                            text: "Ended by mistake?";
                                            color: T.muted;
                                            font-size: 12.5px;
                                            horizontal-stretch: 1;
                                        }
                                        RowLink {
                                            text: "Resume on " + root.resume-code;
                                            clicked => {
                                                root.resume-broadcast();
                                            }
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                cross-axis-alignment: center;
                                Kicker {
                                    text: "YOU'RE SHARING";
                                    horizontal-stretch: 1;
                                }
                                if root.can-change-source: RowLink {
                                    text: "Change";
                                    clicked => {
                                        root.change-source();
                                    }
                                }
                            }
                        }
                        // What the next broadcast shares, as a card: a 1 Hz preview
                        // of it once one arrives (docs/65 D2), its icon until then.
                        source-card := Rectangle {
                            height: ready.card-h;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: T.border;
                            background: sta.has-hover && root.can-change-source ? T.s2 : T.s1;
                            accessible-role: button;
                            accessible-label: "You're sharing: " + (root.next-source != "" ? root.next-source : "nothing chosen yet");
                            accessible-action-default => {
                                root.change-source();
                            }
                            if root.has-preview: VerticalLayout {
                                spacing: 10px;
                                padding: 10px;
                                padding-bottom: 12px;
                                Rectangle {
                                    vertical-stretch: 1;
                                    border-radius: 8px;
                                    background: #101216;
                                    clip: true;
                                    Image {
                                        width: 100%;
                                        height: 100%;
                                        source: root.preview;
                                        image-fit: contain;
                                        accessible-label: "Preview of what you're sharing";
                                    }
                                }
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    if root.has-window && root.windows[root.selected-window].has-icon: Image {
                                        source: root.windows[root.selected-window].icon;
                                        width: 18px;
                                        height: 18px;
                                    }
                                    if !(root.has-window && root.windows[root.selected-window].has-icon): Icon {
                                        commands: root.next-is-window ? Icons.window : Icons.monitor;
                                        size: 16px;
                                    }
                                    Text {
                                        text: root.next-source;
                                        color: T.text;
                                        font-size: 14px;
                                        font-weight: 500;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            if !root.has-preview: VerticalLayout {
                                alignment: center;
                                spacing: 12px;
                                padding: 16px;
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 56px;
                                        height: 56px;
                                        border-radius: 16px;
                                        background: T.s3;
                                        if root.has-window && root.windows[root.selected-window].has-icon: Image {
                                            source: root.windows[root.selected-window].icon;
                                            width: 32px;
                                            height: 32px;
                                        }
                                        if !(root.has-window && root.windows[root.selected-window].has-icon): Icon {
                                            commands: root.next-is-window ? Icons.window : Icons.monitor;
                                            size: 26px;
                                        }
                                    }
                                }
                                Text {
                                    text: root.next-source != "" ? root.next-source : "Nothing chosen yet";
                                    color: T.text;
                                    font-size: 15px;
                                    font-weight: 500;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                                if root.next-source == "": Text {
                                    text: root.system-picker ? root.share-empty-hint : "Pick an app or a display to share.";
                                    color: T.muted;
                                    font-size: 12.5px;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                            sta := TouchArea {
                                enabled: root.can-change-source;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.change-source();
                                }
                            }
                        }
                        ready-bottom := VerticalLayout {
                            spacing: 14px;
                            // D5: Sound · Quality, then the Room list on its own.
                            List {
                                Row {
                                    first: true;
                                    RowIco {
                                        icon: Icons.speaker;
                                    }
                                    RowText {
                                        title: "Sound";
                                        sub: root.system-picker ? (root.share-mode-label != "" ? root.share-mode-label : "A window shares its app's sound. A display shares everything.")
                                            : root.picker-tab == 0 ? "Only this app's sound · follows what you share" : "Everything you hear on this computer";
                                    }
                                    if root.whose-audio: RowLink {
                                        text: "Change";
                                        clicked => {
                                            root.show-audio-sheet = true;
                                        }
                                    }
                                }
                                Row {
                                    RowIco {
                                        icon: Icons.gauge;
                                    }
                                    RowText {
                                        title: "Quality";
                                        sub: root.quality-line;
                                    }
                                    RowLink {
                                        text: "Change";
                                        clicked => {
                                            root.page = 4;
                                        }
                                    }
                                }
                            }
                            List {
                                Row {
                                    first: true;
                                    tinted: root.room-pending != "";
                                    RowIco {
                                        icon: Icons.users;
                                        accent: root.room-pending != "";
                                    }
                                    RowText {
                                        title: root.room-pending != "" ? (root.room-pending == "New room" ? root.room-pending : "Room " + root.room-pending) : "Room";
                                        sub: root.room-pending != "" ? root.room-pending-detail
                                            : root.room-status != "" ? root.room-status : "Stream on your own, or together with friends";
                                    }
                                    if root.room-pending == "": RowLink {
                                        text: "Add";
                                        clicked => {
                                            root.show-room-sheet = true;
                                        }
                                    }
                                    if root.room-pending != "": IconBtn {
                                        icon: Icons.close;
                                        label: "Don't join " + root.room-pending;
                                        box: 32px;
                                        clicked => {
                                            root.room-pending-dismiss();
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 10px;
                                padding-top: 6px;
                                if root.app-version != "": Text {
                                    text: root.app-version;
                                    color: T.muted;
                                    font-size: 12px;
                                }
                                if root.app-version != "": Text {
                                    text: "·";
                                    color: T.muted;
                                    font-size: 12px;
                                }
                                Text {
                                    text: "Terms of use";
                                    color: T.muted;
                                    font-size: 12px;
                                    accessible-role: button;
                                    accessible-action-default => {
                                        root.open-link(root.terms-link);
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.open-link(root.terms-link);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // D6: a line under the header zone once the body scrolls.
                if ready-sv.viewport-y < 0: Rectangle {
                    y: 0;
                    height: 1px;
                    background: T.border;
                }
            }

            // ----- the action bar (D2) -----
            Rectangle {
                height: ready-bar.preferred-height;
                background: T.bg;
                // D6: more of the body is below.
                if ready.more-below: Rectangle {
                    y: -24px;
                    height: 24px;
                    background: @linear-gradient(180deg, #0a0b0d00 0%, #0a0b0deb 100%);
                }
                if ready.more-below: Rectangle {
                    y: 0;
                    height: 1px;
                    background: T.border;
                }
                ready-bar := VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 12px;
                    padding-bottom: 14px;
                    spacing: 6px;
                    Btn {
                        kind: 0;
                        large: true;
                        text: root.room-pending != "" && root.room-pending != "New room" ? "Go live in " + root.room-pending : "Go live";
                        clicked => {
                            root.start-broadcast();
                        }
                    }
                    Text {
                        text: root.summary-visible ? "You'll get a new code to send to friends."
                            : root.room-pending != "" ? "Your stream also gets its own code, as always." : "You'll get a code to send to friends.";
                        color: T.muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // ================= live and paused =================
        // docs/66 D1: the body scrolls; the action bar never does. The
        // preview gives up height before anything scrolls (D5).
        if root.page == 0 && root.on-air: live := VerticalLayout {
            vertical-stretch: 1;
            // The wide layout's right column lives in an `if`, so it reports
            // its own height here.
            property <length> right-h;
            // The left column's width (less the padding, and in a wide window
            // the 20 px gap and the 420 px column), and the preview's natural
            // height: 248 narrow, 16:9 of the column (at most 360) wide.
            property <length> left-w: root.wide ? root.width - 480px : root.width - 40px;
            property <length> prev-natural: root.wide ? Math.min(360px, self.left-w * 9 / 16) : 248px;
            property <length> prev-h: Math.max(160px, Math.min(self.prev-natural, live-sv.visible-height - 32px - live-rest.preferred-height));
            property <length> right: root.wide ? self.right-h : 0px;
            // The header zone, the alert slot and the bar: the window less
            // the body. The body is 4 + 16 padding around max(the preview,
            // 12, the rest; the right column).
            property <length> chrome: root.height - live-sv.visible-height;
            property <length> needs-min: self.chrome + 20px + Math.max(172px + live-rest.preferred-height, self.right);
            property <length> needs: self.chrome + 20px + Math.max(self.prev-natural + 12px + live-rest.preferred-height, self.right);
            property <bool> scrolls: live-body.preferred-height > live-sv.visible-height + 0.5px;
            property <bool> more-below: self.scrolls && live-sv.viewport-y + live-body.preferred-height > live-sv.visible-height + 0.5px;
            init => {
                root.publish-fit(self.needs-min, self.needs, self.scrolls);
            }
            changed needs-min => {
                root.publish-fit(self.needs-min, self.needs, self.scrolls);
            }
            changed needs => {
                root.publish-fit(self.needs-min, self.needs, self.scrolls);
            }
            changed scrolls => {
                root.publish-fit(self.needs-min, self.needs, self.scrolls);
            }

            Rectangle {
                vertical-stretch: 1;
                live-sv := ScrollView {
                    width: 100%;
                    height: 100%;
                    live-body := HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-top: 4px;
                        padding-bottom: 16px;
                        spacing: 20px;

                        // ----- left: preview, notices, and (wide) details -----
                        VerticalLayout {
                            spacing: 12px;
                            alignment: start;
                            horizontal-stretch: 1;
                            preview := Rectangle {
                                height: live.prev-h;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: T.border-soft;
                                background: #101216;
                                clip: true;
                                if root.show-thumbnail: Image {
                                    width: 100%;
                                    height: 100%;
                                    source: root.thumbnail;
                                    image-fit: contain;
                                    accessible-label: "What viewers see";
                                }
                                if !root.show-thumbnail && !root.resuming && !root.paused: Text {
                                    width: 100%;
                                    height: 100%;
                                    text: root.live ? "What viewers see" : "Starting…";
                                    color: T.muted;
                                    font-size: 12.5px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                // Paused: the last frame, dimmed (docs/64 D9).
                                if root.paused: Rectangle {
                                    background: #0a0b0dcc;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 8px;
                                        HorizontalLayout {
                                            alignment: center;
                                            Icon {
                                                commands: Icons.pause;
                                                ink: T.text;
                                                size: 26px;
                                            }
                                        }
                                        Text {
                                            text: "Paused";
                                            color: T.text;
                                            font-size: 14px;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                                if root.resuming && !root.paused: Rectangle {
                                    background: #0a0b0d99;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 8px;
                                        Text {
                                            text: "Lost the connection to the server";
                                            color: T.text;
                                            font-size: 14px;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: root.status-line;
                                            color: T.muted;
                                            font-size: 12.5px;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }

                            live-rest := VerticalLayout {
                                spacing: 12px;
                                // Resume couldn't start (nothing chosen to share, say):
                                // Paused says why, where the button is.
                                if root.paused && root.error-text != "": Banner {
                                    icon: Icons.alert;
                                    body: root.error-text;
                                    dismissible: false;
                                }
                                // docs/64 D11: the app died live; Resume picks it up.
                                if root.crash-resume: Banner {
                                    icon: Icons.alert;
                                    warn: false;
                                    body: "gawk closed while you were live. Resume and anyone still on the page picks you up again by themselves.";
                                    dismissible: false;
                                }
                                if root.audio-hint && !root.audio-dismissed && !root.paused: Banner {
                                    icon: Icons.speaker;
                                    warn: false;
                                    body: root.audio-hint-text;
                                    action: "Share all sound instead";
                                    act => {
                                        root.switch-to-system-audio();
                                    }
                                    dismiss => {
                                        root.audio-dismissed = true;
                                    }
                                }
                                if root.minimized-hint != "" && !root.minimized-dismissed && !root.paused: Banner {
                                    icon: Icons.window;
                                    body: root.minimized-hint;
                                    dismiss => {
                                        root.minimized-dismissed = true;
                                    }
                                }

                                if root.wide: HorizontalLayout {
                                    cross-axis-alignment: center;
                                    Kicker {
                                        text: "DETAILS";
                                        horizontal-stretch: 1;
                                    }
                                    Btn {
                                        kind: 2;
                                        small: true;
                                        icon: Icons.copy;
                                        text: "Copy diagnostics";
                                        clicked => {
                                            root.copy-diagnostics();
                                        }
                                    }
                                }
                                if root.wide: Stats {
                                    rows: root.stats-rows;
                                }
                                if !root.wide: LiveSide {
                                    wide: false;
                                    tight: root.width < 500px;
                                    v: root.lv;
                                    room-key-input <=> root.room-key-input;
                                    copy-link => {
                                        root.copy-link();
                                    }
                                    copy-code => {
                                        root.copy-code();
                                    }
                                    copy-room-link => {
                                        root.copy-room-link();
                                    }
                                    open-link(l) => {
                                        root.open-link(l);
                                    }
                                    change-source => {
                                        root.change-source();
                                    }
                                    change-quality => {
                                        root.page = 4;
                                    }
                                    open-room-sheet => {
                                        root.show-room-sheet = true;
                                    }
                                    room-key-submit => {
                                        root.room-key-submit();
                                    }
                                    open-details => {
                                        root.show-details = true;
                                    }
                                    leave-room => {
                                        root.room-detach();
                                    }
                                    rejoin-room => {
                                        root.room-rejoin();
                                    }
                                    dismiss-pending => {
                                        root.room-pending-dismiss();
                                    }
                                }
                            }
                        }

                        // ----- right column in a wide window (D7) -----
                        if root.wide: LiveSide {
                            width: 420px;
                            wide: true;
                            tight: true;
                            v: root.lv;
                            property <length> ph: self.preferred-height;
                            init => {
                                live.right-h = self.ph;
                            }
                            changed ph => {
                                live.right-h = self.ph;
                            }
                            room-key-input <=> root.room-key-input;
                            copy-link => {
                                root.copy-link();
                            }
                            copy-code => {
                                root.copy-code();
                            }
                            copy-room-link => {
                                root.copy-room-link();
                            }
                            open-link(l) => {
                                root.open-link(l);
                            }
                            change-source => {
                                root.change-source();
                            }
                            change-quality => {
                                root.page = 4;
                            }
                            open-room-sheet => {
                                root.show-room-sheet = true;
                            }
                            room-key-submit => {
                                root.room-key-submit();
                            }
                            open-details => {
                                root.show-details = true;
                            }
                            leave-room => {
                                root.room-detach();
                            }
                            rejoin-room => {
                                root.room-rejoin();
                            }
                            dismiss-pending => {
                                root.room-pending-dismiss();
                            }
                        }
                    }
                }
                // D6: a line under the header zone once the body scrolls.
                if live-sv.viewport-y < 0: Rectangle {
                    y: 0;
                    height: 1px;
                    background: T.border;
                }
            }

            // ----- the action bar (D2): the primary and the broadcast's controls -----
            Rectangle {
                height: 64px;
                background: T.bg;
                // How wide the bar is with Copy code labelled, in this font:
                // under that, Copy code is an icon (the root's `narrow-bar`).
                // The padding, three gaps, and 16 px between the two groups.
                property <length> labelled: 40px + 3 * 8px + 16px + link-btn.labelled-width
                    + code-btn.labelled-width + rest-btn.labelled-width + end-btn.labelled-width;
                init => {
                    root.bar-labelled = self.labelled;
                }
                changed labelled => {
                    root.bar-labelled = self.labelled;
                }
                // D6: more of the body is below.
                if live.more-below: Rectangle {
                    y: -24px;
                    height: 24px;
                    background: @linear-gradient(180deg, #0a0b0d00 0%, #0a0b0deb 100%);
                }
                if live.more-below: Rectangle {
                    y: 0;
                    height: 1px;
                    background: T.border;
                }
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 8px;
                    cross-axis-alignment: center;
                    // docs/64 OD2: your own link is the primary, alone or in a
                    // room. Paused, it steps down for Resume (docs/64 D9).
                    link-btn := Btn {
                        kind: root.paused ? 1 : 0;
                        icon: Icons.link;
                        text: "Copy link";
                        confirm: true;
                        enabled: root.join-link != "";
                        clicked => {
                            root.copy-link();
                        }
                    }
                    code-btn := CopyCodeBtn {
                        narrow: root.narrow-bar;
                        enabled: root.code != "";
                        clicked => {
                            root.copy-code();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    // Pause, or in its place Resume as the page's primary.
                    rest-btn := Btn {
                        kind: root.paused ? 0 : 1;
                        icon: root.paused ? Icons.play : Icons.pause;
                        icon-filled: root.paused;
                        text: root.paused ? "Resume" : "Pause";
                        // Starting has no session to pause yet.
                        enabled: root.paused || (root.live && !root.lv.starting);
                        clicked => {
                            if (root.paused) {
                                root.resume-broadcast();
                            } else {
                                root.pause-broadcast();
                            }
                        }
                    }
                    end-btn := Btn {
                        kind: 3;
                        icon: Icons.stop;
                        text: "End";
                        enabled: root.live || root.paused;
                        clicked => {
                            if (root.crash-resume) {
                                root.resume-dismiss();
                            } else {
                                root.stop-broadcast();
                            }
                        }
                    }
                }
            }
        }

        // ================= choose what to share (Windows) =================
        if root.page == 1: picker := VerticalLayout {
            vertical-stretch: 1;
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 16px;
            spacing: 14px;
            property <bool> draft-ok: (root.draft-tab == 0 && root.draft-window >= 0 && root.draft-window < root.windows.length) || (root.draft-tab == 1 && root.draft-monitor >= 0 && root.draft-monitor < root.monitors.length);
            property <string> draft-name: root.draft-tab == 0 && root.draft-window >= 0 && root.draft-window < root.windows.length ? root.windows[root.draft-window].title
                : root.draft-tab == 1 && root.draft-monitor >= 0 && root.draft-monitor < root.monitors.length ? root.monitors[root.draft-monitor].label : "";
            Seg {
                options: ["Apps and games", "Whole display"];
                current: root.draft-tab;
                changed(i) => {
                    root.view-picker-tab(i);
                }
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    if root.draft-tab == 0 && root.windows.length > 0: List {
                        for w[i] in root.windows: Row {
                            first: i == 0;
                            clickable: true;
                            tinted: root.draft-window == i;
                            accessible-role: button;
                            accessible-label: w.title;
                            accessible-checked: root.draft-window == i;
                            accessible-action-default => {
                                root.draft-window = i;
                            }
                            clicked => {
                                root.draft-window = i;
                            }
                            Rectangle {
                                width: 18px;
                                height: 18px;
                                border-radius: 9px;
                                border-width: root.draft-window == i ? 5px : 1.5px;
                                border-color: root.draft-window == i ? T.accent : T.faint;
                            }
                            if w.has-icon: Image {
                                source: w.icon;
                                width: 20px;
                                height: 20px;
                            }
                            if !w.has-icon: Icon {
                                commands: Icons.window;
                            }
                            RowText {
                                title: w.title;
                            }
                            if root.live && !root.paused && root.picker-tab == 0 && root.selected-window == i: Rectangle {
                                height: 20px;
                                width: nl.preferred-width;
                                border-radius: 6px;
                                background: T.live-soft;
                                nl := HorizontalLayout {
                                    padding-left: 7px;
                                    padding-right: 7px;
                                    Text {
                                        text: "SHARING NOW";
                                        color: T.live-text;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    if root.draft-tab == 0 && root.windows.length == 0: Text {
                        text: "No shareable windows found. Open the app you want to share, then refresh.";
                        color: T.muted;
                        font-size: 12.5px;
                        wrap: word-wrap;
                    }
                    if root.draft-tab == 1: List {
                        for m[i] in root.monitors: Row {
                            first: i == 0;
                            clickable: true;
                            tinted: root.draft-monitor == i;
                            accessible-role: button;
                            accessible-label: m.label;
                            accessible-checked: root.draft-monitor == i;
                            accessible-action-default => {
                                root.draft-monitor = i;
                            }
                            clicked => {
                                root.draft-monitor = i;
                            }
                            Rectangle {
                                width: 18px;
                                height: 18px;
                                border-radius: 9px;
                                border-width: root.draft-monitor == i ? 5px : 1.5px;
                                border-color: root.draft-monitor == i ? T.accent : T.faint;
                            }
                            Icon {
                                commands: Icons.monitor;
                            }
                            RowText {
                                title: m.label;
                            }
                            if root.live && !root.paused && root.picker-tab == 1 && root.selected-monitor == i: Rectangle {
                                height: 20px;
                                width: ml.preferred-width;
                                border-radius: 6px;
                                background: T.live-soft;
                                ml := HorizontalLayout {
                                    padding-left: 7px;
                                    padding-right: 7px;
                                    Text {
                                        text: "SHARING NOW";
                                        color: T.live-text;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Text {
                text: root.draft-tab == 0 ? "Fullscreen game not listed? Pick Whole display." : "Works with exclusive-fullscreen games.";
                color: T.muted;
                font-size: 12.5px;
                wrap: word-wrap;
            }
            Banner {
                warn: false;
                icon: Icons.speaker;
                body: root.draft-tab == 0 ? "Sharing an app streams only that app's sound. Voice calls and music stay private." : "Sharing a display streams everything you hear on this computer.";
                dismissible: false;
            }
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    horizontal-stretch: 1;
                }
                if root.live && !root.paused: Btn {
                    kind: 2;
                    text: "Cancel";
                    clicked => {
                        root.page = 0;
                    }
                }
                Btn {
                    kind: 0;
                    icon: root.live && !root.paused ? Icons.swap : "";
                    text: root.live && !root.paused ? (picker.draft-name != "" ? "Switch to " + picker.draft-name : "Switch") : "Share this";
                    enabled: picker.draft-ok;
                    clicked => {
                        root.commit-picker();
                    }
                }
            }
        }

        // ================= settings: server and app (D18) =================
        if root.page == 2: ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 4px;
                padding-bottom: 20px;
                spacing: 22px;
                alignment: start;

                VerticalLayout {
                    spacing: 10px;
                    alignment: start;
                    Kicker {
                        text: "SERVER";
                    }
                    List {
                        for label[i] in root.server-labels: Row {
                            first: i == 0;
                            clickable: true;
                            enabled: !root.busy && !root.paused;
                            clicked => {
                                root.set-server = i;
                                root.server-selected();
                            }
                            accessible-role: button;
                            accessible-label: label;
                            accessible-checked: root.set-server == i;
                            accessible-action-default => {
                                if (!root.busy && !root.paused) {
                                    root.set-server = i;
                                    root.server-selected();
                                }
                            }
                            Rectangle {
                                width: 18px;
                                height: 18px;
                                border-radius: 9px;
                                border-width: root.set-server == i ? 5px : 1.5px;
                                border-color: root.set-server == i ? T.accent : T.faint;
                            }
                            RowText {
                                title: label;
                                sub: i < root.server-urls.length ? root.server-urls[i] : "";
                                sub-color: root.set-server == i && root.probe-state == 2 ? T.warn-text : T.muted;
                            }
                            RowLink {
                                text: "Edit";
                                enabled: !root.busy && !root.paused;
                                clicked => {
                                    root.edit-server(i);
                                    root.page = 3;
                                }
                            }
                        }
                        Row {
                            clickable: true;
                            enabled: !root.busy && !root.paused;
                            clicked => {
                                root.add-server();
                                root.page = 3;
                            }
                            accessible-role: button;
                            accessible-label: "Add a server";
                            accessible-action-default => {
                                if (!root.busy && !root.paused) {
                                    root.add-server();
                                    root.page = 3;
                                }
                            }
                            Icon {
                                commands: Icons.plus;
                                size: 16px;
                            }
                            Text {
                                text: "Add a server";
                                color: T.muted;
                                font-size: 14px;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    if root.busy || root.paused: Text {
                        text: "A different server means a different code, so you can switch after you end this broadcast.";
                        color: T.muted;
                        font-size: 12.5px;
                        wrap: word-wrap;
                    }
                }

                VerticalLayout {
                    spacing: 10px;
                    alignment: start;
                    Kicker {
                        text: "APP";
                    }
                    List {
                        Row {
                            first: true;
                            RowText {
                                title: "Check for updates";
                                sub: "A small file from GitHub, at most every 15 minutes.";
                            }
                            Switch {
                                on: root.set-update-check;
                                label: "Check for updates";
                                toggled => {
                                    root.set-update-check = !root.set-update-check;
                                    root.settings-edited();
                                }
                            }
                        }
                        Row {
                            RowText {
                                title: root.app-version != "" ? root.app-version : "gawk";
                                sub: root.update-status != "" ? root.update-status : "The version you're running.";
                            }
                            Btn {
                                small: true;
                                text: root.update-checking ? "Checking…" : "Check now";
                                enabled: !root.update-checking;
                                clicked => {
                                    root.check-for-updates();
                                }
                            }
                        }
                        Row {
                            RowText {
                                title: "Join links";
                                sub: root.set-app-url != "" ? root.set-app-url : "The official site";
                            }
                            RowLink {
                                text: "Change";
                                clicked => {
                                    root.show-links-sheet = true;
                                }
                            }
                        }
                        Row {
                            RowText {
                                title: "Diagnostics";
                                sub: root.caption-diag;
                            }
                            RowLink {
                                text: "Change";
                                clicked => {
                                    root.show-diag-sheet = true;
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: root.caption-broadcast;
                        color: T.muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: "By broadcasting you accept the operator's";
                            color: T.muted;
                            font-size: 12px;
                        }
                        Text {
                            text: "terms of use.";
                            color: T.accent;
                            font-size: 12px;
                            accessible-role: button;
                            accessible-action-default => {
                                root.open-link(root.terms-link);
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open-link(root.terms-link);
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }

        // ================= edit server (D15) =================
        if root.page == 3: ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 4px;
                padding-bottom: 20px;
                spacing: 18px;
                alignment: start;

                // The default's identity is not editable (its URL is the
                // build's pinned fleet); only custom servers expose name and
                // URL. The secret edits whichever is open — the default's
                // credential slot stays editable (docs/40 F4).
                if !root.server-is-custom: List {
                    Row {
                        first: true;
                        RowText {
                            title: "Official server";
                            sub: "Name";
                        }
                        Pill {
                            text: "BUILT IN";
                        }
                    }
                    Row {
                        RowText {
                            title: root.default-relay;
                            title-font: root.mono-font;
                            sub: "Relay address";
                        }
                        Pill {
                            text: "BUILT IN";
                        }
                    }
                }
                if root.server-is-custom: LabeledField {
                    label: "Name";
                    text <=> root.set-server-name;
                    edited => {
                        root.settings-edited();
                    }
                }
                if root.server-is-custom: LabeledField {
                    label: "Relay address";
                    placeholder: "https://relay.example.com:4433";
                    text <=> root.set-relay;
                    font-family: root.mono-font;
                    edited => {
                        root.settings-edited();
                    }
                }
                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Publish secret";
                        color: T.muted;
                        font-size: 12.5px;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Field {
                            horizontal-stretch: 1;
                            label: "Publish secret";
                            placeholder: "Only if the server's operator gave you one";
                            text <=> root.set-secret;
                            password: !root.show-secret;
                            font-family: root.mono-font;
                            edited => {
                                root.settings-edited();
                            }
                        }
                        Btn {
                            text: root.show-secret ? "Hide" : "Show";
                            clicked => {
                                root.show-secret = !root.show-secret;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    cross-axis-alignment: center;
                    Btn {
                        small: true;
                        icon: Icons.refresh;
                        text: root.test-state == 1 ? "Testing…" : "Test connection";
                        enabled: root.test-state != 1;
                        clicked => {
                            root.test-server();
                        }
                    }
                    if root.test-state >= 2: Dot {
                        state: root.test-state == 2 ? 0 : 1;
                    }
                    if root.test-state >= 2: Text {
                        text: root.test-result;
                        color: root.test-state == 2 ? T.muted : T.warn-text;
                        font-size: 12.5px;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
                if root.server-is-custom: HorizontalLayout {
                    alignment: start;
                    padding-top: 8px;
                    Btn {
                        kind: 3;
                        small: true;
                        text: "Remove this server";
                        clicked => {
                            root.remove-server();
                            root.page = 2;
                        }
                    }
                }
            }
        }

        // ================= quality (D18) =================
        if root.page == 4: ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 4px;
                padding-bottom: 20px;
                spacing: 10px;
                alignment: start;

                // docs/66 D4: the alert strip's full text, where its fix is.
                if root.uplink-warning != "": Banner {
                    icon: Icons.alert;
                    body: root.uplink-warning;
                    dismissible: false;
                }
                Text {
                    text: "Resolution";
                    color: T.muted;
                    font-size: 12.5px;
                }
                Seg {
                    options: root.resolution-labels;
                    current: root.set-resolution;
                    changed(i) => {
                        root.set-resolution = i;
                        root.settings-edited();
                    }
                }
                // Custom size lives with Custom (D15), not a page away.
                if root.set-resolution == 4: HorizontalLayout {
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Field {
                        width: 110px;
                        label: "Custom width";
                        placeholder: "width";
                        text <=> root.set-custom-width;
                        font-family: root.mono-font;
                        edited => {
                            root.settings-edited();
                        }
                    }
                    Text {
                        text: "×";
                        color: T.muted;
                    }
                    Field {
                        width: 110px;
                        label: "Custom height";
                        placeholder: "height";
                        text <=> root.set-custom-height;
                        font-family: root.mono-font;
                        edited => {
                            root.settings-edited();
                        }
                    }
                    Text {
                        text: "up to 3840×2160";
                        color: T.muted;
                        font-size: 12.5px;
                        horizontal-stretch: 1;
                    }
                }
                Rectangle {
                    height: 6px;
                }
                Text {
                    text: "Frame rate";
                    color: T.muted;
                    font-size: 12.5px;
                }
                Seg {
                    options: root.framerate-labels;
                    current: root.set-framerate;
                    changed(i) => {
                        root.set-framerate = i;
                        root.settings-edited();
                    }
                }
                Rectangle {
                    height: 6px;
                }
                HorizontalLayout {
                    Text {
                        text: "Upload cap";
                        color: T.muted;
                        font-size: 12.5px;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.set-bitrate == "" ? "12 Mbps (default)" : root.set-bitrate + " Mbps";
                        color: T.text;
                        font-size: 14px;
                    }
                }
                // A slider over 2–40 Mbps; blank means the default (12). A
                // value from an older file outside the range shows as its
                // number until the slider moves (docs/64 D15).
                cap-slider := Rectangle {
                    height: 24px;
                    property <float> value: root.set-bitrate == "" ? 12 : Math.clamp(root.set-bitrate.to-float(), 2, 40);
                    property <float> frac: (self.value - 2) / 38;
                    accessible-role: slider;
                    accessible-label: "Upload cap in Mbps";
                    accessible-value: self.value;
                    accessible-value-minimum: 2;
                    accessible-value-maximum: 40;
                    accessible-value-step: 1;
                    accessible-action-increment => {
                        root.set-bitrate = Math.min(40, Math.round(self.value) + 1);
                        root.settings-edited();
                    }
                    accessible-action-decrement => {
                        root.set-bitrate = Math.max(2, Math.round(self.value) - 1);
                        root.settings-edited();
                    }
                    Rectangle {
                        x: 9px;
                        y: (parent.height - self.height) / 2;
                        width: parent.width - 18px;
                        height: 6px;
                        border-radius: 3px;
                        background: T.s3;
                        Rectangle {
                            x: 0;
                            width: parent.width * cap-slider.frac;
                            height: 100%;
                            border-radius: 3px;
                            background: T.accent;
                        }
                    }
                    Rectangle {
                        x: (parent.width - 18px) * cap-slider.frac;
                        y: (parent.height - self.height) / 2;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: T.text;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && self.pressed)) {
                                root.set-bitrate = Math.round(2 + 38 * Math.clamp((self.mouse-x - 9px) / (self.width - 18px), 0, 1));
                            }
                            // Applied on release: a drag is one change, and
                            // live one restart (docs/64 D13).
                            if (e.kind == PointerEventKind.up) {
                                root.settings-edited();
                            }
                        }
                        moved => {
                            root.set-bitrate = Math.round(2 + 38 * Math.clamp((self.mouse-x - 9px) / (self.width - 18px), 0, 1));
                        }
                    }
                }
                HorizontalLayout {
                    Text {
                        text: "Lower it if people watching see stutter.";
                        color: T.muted;
                        font-size: 12.5px;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    if root.set-bitrate != "": RowLink {
                        text: "Use default";
                        chevron: false;
                        clicked => {
                            root.set-bitrate = "";
                            root.settings-edited();
                        }
                    }
                }
            }
        }
    }

    // ================= sheets and cards =================

    // Whose audio? (Linux, docs/58 D9, docs/39 D5): the applications
    // playing sound now, live, plus the two fixed rows.
    if root.show-audio-sheet: Sheet {
        title: "Whose audio?";
        subtitle: "Your desktop's picker doesn't say whose window you chose, so pick whose sound viewers hear.";
        sheet-height: 520px;
        close => {
            root.show-audio-sheet = false;
        }
        ScrollView {
            vertical-stretch: 1;
            min-height: 160px;
            List {
                for app[i] in root.audio-apps: Row {
                    first: i == 0;
                    clickable: true;
                    tinted: root.audio-choice == i;
                    clicked => {
                        root.audio-choice = i;
                        root.audio-choice-changed();
                        root.show-audio-sheet = false;
                    }
                    RowIco {
                        icon: Icons.speaker;
                        accent: root.audio-choice == i;
                    }
                    RowText {
                        title: app.name;
                        sub: app.binary + (app.streams == 1 ? " · 1 stream" : " · " + app.streams + " streams");
                    }
                }
                Row {
                    first: root.audio-apps.length == 0;
                    clickable: true;
                    tinted: root.audio-choice == -1;
                    clicked => {
                        root.audio-choice = -1;
                        root.audio-choice-changed();
                        root.show-audio-sheet = false;
                    }
                    RowIco {
                        icon: Icons.monitor;
                        accent: root.audio-choice == -1;
                    }
                    RowText {
                        title: "Whole system";
                        sub: "Everything you hear on this computer";
                    }
                }
                Row {
                    clickable: true;
                    tinted: root.audio-choice == -2;
                    clicked => {
                        root.audio-choice = -2;
                        root.audio-choice-changed();
                        root.show-audio-sheet = false;
                    }
                    RowIco {
                        icon: Icons.close;
                        accent: root.audio-choice == -2;
                    }
                    RowText {
                        title: "No audio";
                        sub: "Video only";
                    }
                }
            }
        }
        Text {
            text: "Apps appear here when they play sound — start the game's audio first if the list looks empty.";
            color: T.muted;
            font-size: 12.5px;
            wrap: word-wrap;
        }
    }

    // Add to a room (docs/60 D8). Idle, the choice becomes the pending room;
    // live, it joins now.
    if root.show-room-sheet && !root.room-active: Sheet {
        title: "Add to a room";
        subtitle: "Stream alongside friends. Viewers see everyone's screen in one place.";
        sheet-height: 640px;
        close => {
            root.show-room-sheet = false;
            root.editing-name = false;
        }
        HorizontalLayout {
            spacing: 8px;
            Field {
                horizontal-stretch: 1;
                label: "Room code or link";
                placeholder: "Room code, or paste a room link";
                text <=> root.room-input;
                edited => {
                    root.room-input-edited();
                }
                accepted => {
                    if (root.room-input-ok) {
                        root.room-join();
                    }
                }
            }
            Btn {
                kind: 0;
                text: "Join";
                enabled: root.room-input-ok;
                clicked => {
                    root.room-join();
                }
            }
        }
        if root.room-input-echo != "": Text {
            text: root.room-input-echo;
            color: root.room-input-ok ? T.muted : T.danger-text;
            font-size: 12.5px;
        }
        Text {
            text: "or";
            color: T.muted;
            font-size: 12px;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            spacing: 12px;
            cross-axis-alignment: center;
            Btn {
                icon: Icons.plus;
                text: "Create a new room";
                clicked => {
                    root.room-create();
                }
            }
            Text {
                text: root.busy ? "You get a room code to share." : "It's made when you go live, and you get a code to share.";
                color: T.muted;
                font-size: 12.5px;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
        }
        if root.recent-rooms.length > 0: Kicker {
            text: "YOUR ROOMS";
        }
        if root.recent-rooms.length > 0: ScrollView {
            vertical-stretch: 1;
            min-height: 120px;
            VerticalLayout {
                alignment: start;
                List {
                    for r[i] in root.recent-rooms: Row {
                        first: i == 0;
                        IconBtn {
                            box: 32px;
                            icon: Icons.star;
                            filled: r.saved;
                            ink: r.saved ? T.accent : T.muted;
                            label: r.saved ? "Unsave " + r.code : "Save " + r.code;
                            clicked => {
                                root.room-toggle-saved(r.code);
                            }
                        }
                        RowText {
                            title: r.code;
                            sub: r.detail;
                        }
                        Btn {
                            small: true;
                            text: "Join";
                            clicked => {
                                root.room-join-recent(r.code);
                            }
                        }
                    }
                }
            }
        }
        if root.recent-rooms.length == 0: Rectangle {
            vertical-stretch: 1;
        }
        // The name: one line, "Joining as name · Change name".
        Rectangle {
            border-radius: 12px;
            background: T.s2;
            HorizontalLayout {
                padding: 10px;
                padding-left: 14px;
                spacing: 10px;
                cross-axis-alignment: center;
                if !root.editing-name: Text {
                    text: root.room-nickname == "" ? "No name yet: the room picks one for you." : "Joining as " + root.room-nickname;
                    color: T.text;
                    font-size: 13px;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if !root.editing-name: RowLink {
                    text: "Change name";
                    chevron: false;
                    clicked => {
                        root.editing-name = true;
                    }
                }
                if root.editing-name: Field {
                    horizontal-stretch: 1;
                    label: "Your name in the room";
                    placeholder: "Your name";
                    text <=> root.room-nickname;
                    edited => {
                        root.room-nickname-edited();
                    }
                    accepted => {
                        root.room-nickname-accepted();
                        root.editing-name = false;
                    }
                }
                if root.editing-name: Btn {
                    small: true;
                    text: "Save";
                    enabled: root.room-nickname != "";
                    clicked => {
                        root.room-nickname-accepted();
                        root.editing-name = false;
                    }
                }
            }
        }
    }

    // The room sheet (docs/64 D16): the room's links, your name, the streams
    // — Remove and End for its creator. Leave room is on the card (D6).
    if root.show-room-sheet && root.room-active: Sheet {
        title: root.room-code != "" ? "Room " + root.room-code : "Room";
        subtitle: root.room-creator ? "You made this room." : root.room-status;
        sheet-height: 640px;
        close => {
            root.show-room-sheet = false;
            root.editing-name = false;
        }
        HorizontalLayout {
            spacing: 10px;
            Btn {
                kind: 4;
                horizontal-stretch: 1;
                icon: Icons.link;
                text: "Copy room link";
                confirm: true;
                enabled: root.room-link != "";
                clicked => {
                    root.copy-room-link();
                }
            }
            Btn {
                icon: Icons.external;
                text: "Open room view";
                enabled: root.room-link != "";
                clicked => {
                    root.open-link(root.room-link);
                }
            }
        }
        List {
            Row {
                first: true;
                if !root.editing-name: RowText {
                    title: root.room-nickname == "" ? "No name yet" : "In the room as " + root.room-nickname;
                    sub: "Everyone in the room sees this name";
                }
                if !root.editing-name: RowLink {
                    text: "Change name";
                    chevron: false;
                    clicked => {
                        root.editing-name = true;
                    }
                }
                if root.editing-name: Field {
                    horizontal-stretch: 1;
                    label: "Your name in the room";
                    placeholder: "Your name";
                    text <=> root.room-nickname;
                    edited => {
                        root.room-nickname-edited();
                    }
                    accepted => {
                        root.room-nickname-accepted();
                        root.editing-name = false;
                    }
                }
                if root.editing-name: Btn {
                    small: true;
                    text: "Save";
                    enabled: root.room-nickname != "";
                    clicked => {
                        root.room-nickname-accepted();
                        root.editing-name = false;
                    }
                }
            }
        }
        Kicker {
            text: "STREAMS";
        }
        ScrollView {
            vertical-stretch: 1;
            min-height: 120px;
            VerticalLayout {
                alignment: start;
                List {
                    for r[i] in root.room-rows: Row {
                        first: i == 0;
                        Avatar {
                            initial: r.initial;
                            tint: r.tint;
                            ring: r.you;
                        }
                        RowText {
                            title: r.you ? r.name + " (you)" : r.name;
                            sub: r.detail;
                            sub-color: r.away ? T.warn-text : T.muted;
                        }
                        if r.removable: Btn {
                            kind: 2;
                            small: true;
                            text: "Remove";
                            clicked => {
                                root.room-remove(r.broadcast-id);
                            }
                        }
                    }
                }
            }
        }
        if root.room-creator: Text {
            text: "Removing a stream takes it out of the room. It stays live on its own code.";
            color: T.muted;
            font-size: 12.5px;
            wrap: word-wrap;
        }
        if root.room-creator: HorizontalLayout {
            Rectangle {
                horizontal-stretch: 1;
            }
            Btn {
                kind: 3;
                text: "End room for everyone";
                clicked => {
                    root.room-end();
                    root.show-room-sheet = false;
                }
            }
        }
    }

    // Join links (D15): where the links people open point.
    if root.show-links-sheet: Sheet {
        title: "Join links";
        subtitle: "The site your code's link opens. Blank uses the official site.";
        sheet-height: 320px;
        close => {
            root.show-links-sheet = false;
        }
        LabeledField {
            label: "Web address for join links";
            placeholder: "Blank uses the official site";
            text <=> root.set-app-url;
            font-family: root.mono-font;
            edited => {
                root.settings-edited();
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
    }

    // Diagnostics (D15): where they go, and a copy for a bug report.
    if root.show-diag-sheet: Sheet {
        title: "Diagnostics";
        subtitle: root.caption-diag;
        sheet-height: 380px;
        close => {
            root.show-diag-sheet = false;
        }
        LabeledField {
            label: "Diagnostics address (blank = default, \"off\" = send nothing)";
            text <=> root.set-telemetry;
            font-family: root.mono-font;
            edited => {
                root.settings-edited();
            }
        }
        if root.encode-line != "": Text {
            text: "Encoder: " + root.encode-line;
            color: T.muted;
            font-size: 12.5px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            spacing: 10px;
            cross-axis-alignment: center;
            Btn {
                icon: Icons.copy;
                text: "Copy diagnostics";
                clicked => {
                    root.copy-diagnostics();
                }
            }
            if root.copied-note != "": Text {
                text: root.copied-note;
                color: T.ok;
                font-size: 12.5px;
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
    }

    // Details, in the narrow window (the wide one shows them inline).
    if root.show-details && !root.wide: Sheet {
        title: "Details";
        sheet-height: 620px;
        close => {
            root.show-details = false;
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                Stats {
                    rows: root.stats-rows;
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            cross-axis-alignment: center;
            Btn {
                icon: Icons.copy;
                text: "Copy diagnostics";
                clicked => {
                    root.copy-diagnostics();
                }
            }
            if root.copied-note != "": Text {
                text: root.copied-note;
                color: T.ok;
                font-size: 12.5px;
            }
        }
    }

    // The room ended, or the creator removed this stream (docs/60 D10).
    if root.room-card-title != "": Modal {
        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: T.s3;
            Icon {
                commands: Icons.users;
                size: 22px;
            }
        }
        Text {
            text: root.room-card-title;
            color: T.text;
            font-size: 17px;
            font-weight: 600;
            wrap: word-wrap;
        }
        Text {
            text: root.room-card-body;
            color: T.muted;
            font-size: 14px;
            wrap: word-wrap;
        }
        Btn {
            kind: 0;
            text: "Back to my stream";
            clicked => {
                root.room-card-dismiss();
            }
        }
    }

    // ================= close-while-on-air confirm (docs/38 D12) =================
    if root.confirm-close: Modal {
        card-width: 400px;
        Text {
            text: root.paused ? "Your broadcast is paused. End it and quit?" : "You're live. End and quit?";
            color: T.text;
            font-size: 17px;
            font-weight: 600;
            wrap: word-wrap;
        }
        Text {
            text: root.watching-known && root.watching > 0 && !root.paused ? "Closing gawk ends your broadcast for the " + root.watching + (root.watching == 1 ? " person" : " people") + " watching." : "Closing gawk ends your broadcast.";
            color: T.muted;
            font-size: 14px;
            wrap: word-wrap;
        }
        Btn {
            kind: 0;
            text: "Keep broadcasting";
            clicked => {
                root.confirm-close = false;
            }
        }
        Btn {
            kind: 3;
            text: "End and quit";
            clicked => {
                root.quit-confirmed();
            }
        }
    }
}
