<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  gawk-broadcast-macos.app's Info.plist (R52, docs/54 D14). bundle.sh fills
  @VERSION@ from gawk-broadcast-desktop/version.txt, which release-please
  maintains, and copies assets/icon/gawk.icns into Contents/Resources. The
  .icns is a tools/icon derivative (R44): the mark has one source and its
  derivatives are generated, never drawn.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>gawk-broadcast</string>
	<key>CFBundleExecutable</key>
	<string>gawk-broadcast-macos</string>
	<!-- The Dock/Finder icon, Contents/Resources/gawk.icns (the extension is
	     implied). macOS ignores a window's own icon, so this is the only
	     source of it. -->
	<key>CFBundleIconFile</key>
	<string>gawk</string>
	<!-- docs/54 D13: derived from the project domain the default relay and
	     app URLs already name. It keys the TCC grant and the notification
	     center, so it must never change once a release ships; a fork edits
	     it like SITE_URL. -->
	<key>CFBundleIdentifier</key>
	<string>fi.ioio.gawk.broadcast</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>gawk-broadcast</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- R66 (docs/68 D10): gawk:// links open this app. LaunchServices
	     registers the scheme when the bundle is first launched or copied;
	     the link arrives as a GURL Apple Event, never in argv. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>fi.ioio.gawk.broadcast.link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>gawk</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.video</string>
	<!-- docs/54 OD5: macOS 14 (Sonoma) brings the system content picker. -->
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Shown only if the non-picker capture path is ever hit (docs/54 D13);
	     the system picker needs no Screen Recording grant. -->
	<key>NSScreenCaptureUsageDescription</key>
	<string>gawk-broadcast streams the window, app or display you choose to your viewers.</string>
</dict>
</plist>
