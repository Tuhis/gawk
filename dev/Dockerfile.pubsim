# gawk-pubsim: the synthetic broadcaster the `sim` and `rooms` profiles run
# (R38, docs/41 §4.5). It drives the real publisher engine — announce, resume
# token, reliable keyframe streams, delta datagrams, TimeSync — with a
# committed H.264 fixture instead of a GPU, so a developer can watch a live
# broadcast without screen-sharing anything. The fixture is embedded in the
# binary, so the runtime image needs nothing beside it.
#
# It lives in gawk-server (cmd/gawk-pubsim + internal/pubsim, since R56 LX9)
# and is pure Go, so the build context is gawk-server/ alone:
#
#   docker build -f dev/Dockerfile.pubsim -t gawk-pubsim:dev gawk-server
#
# It lives under dev/ rather than in gawk-server/deploy/ deliberately: the
# relay's image and chart are a deployed component, and pubsim is test
# tooling that must not ride along in either.

FROM golang:1.26-alpine AS build
WORKDIR /src
# Manifests before sources: the `go mod download` layer then depends on
# go.mod/go.sum alone, and a persistent build cache (a developer's own
# `docker compose up --build`) reuses it across every edit that does not touch
# dependencies, instead of re-downloading every module after each change.
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/gawk-pubsim ./cmd/gawk-pubsim

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/gawk-pubsim /gawk-pubsim
ENTRYPOINT ["/gawk-pubsim"]
