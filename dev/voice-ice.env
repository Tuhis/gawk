# The dev voice lane's Ice mode (R85, docs/89), the default: the roster from
# murmur's Ice, murmur pushing changes to the bridge at mumble-bridge:6503.
# VOICE_ROSTER=observer swaps this file for voice-observer.env.
GAWK_BRIDGE_MUMBLE_ICE_ADDR=murmur:6502
GAWK_BRIDGE_MUMBLE_ICE_SECRET=gawk-dev-ice-write
GAWK_BRIDGE_MUMBLE_ICE_CALLBACK_HOST=mumble-bridge
